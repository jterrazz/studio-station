#!/bin/sh
# The login keychain: every call is recorded in $HOME/.calls (the stdin of `security -i`
# too, where a kept value travels); a lookup finds nothing.
printf 'security %s\n' "$*" >> "$HOME/.calls"
case "$1" in
    find-generic-password) exit 44 ;;
    delete-generic-password) exit 0 ;;
    -i) /bin/cat >> "$HOME/.calls" ;;
    *)
        echo "stub security: unexpected invocation: $*" >&2
        exit 97
        ;;
esac
