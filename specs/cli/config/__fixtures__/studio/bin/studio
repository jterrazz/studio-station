#!/bin/sh
# The studio CLI's credential store: every call is recorded in $HOME/.calls; an export
# answers with the file under answers/studio/export.json and its exit code.
answers="${0%/*}/../answers/studio"
printf 'studio %s\n' "$*" >> "$HOME/.calls"
case "$*" in
    "credentials export "*)
        /bin/cat "$answers/export.json"
        exit "$(/bin/cat "$answers/export.exit")"
        ;;
    "credentials delete "*) ;;
    *)
        echo "stub studio: unexpected invocation: $*" >&2
        exit 97
        ;;
esac
