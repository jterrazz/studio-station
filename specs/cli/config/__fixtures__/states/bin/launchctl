#!/bin/sh
# launchctl print-disabled system, with Remote Login enabled.
printf 'launchctl %s\n' "$*" >> "$HOME/.calls"
case "$*" in
    "print-disabled system") echo '	"com.openssh.sshd" => enabled' ;;
    *)
        echo "stub launchctl: unexpected invocation: $*" >&2
        exit 97
        ;;
esac
