#!/bin/sh
# studio inside the VM: an import keeps its stdin in $TEST_WORKDIR/imported.json (never in
# .calls, so no value shows in a call log); a delete exits with answers/vm-studio/delete.exit.
case "$*" in
    "credentials import") /bin/cat > "$TEST_WORKDIR/imported.json" ;;
    "credentials delete "*) exit "$(/bin/cat "$TEST_WORKDIR/answers/vm-studio/delete.exit")" ;;
    *)
        echo "stub studio: unexpected invocation: $*" >&2
        exit 97
        ;;
esac
