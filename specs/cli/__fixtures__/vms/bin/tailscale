#!/bin/sh
# The Tailscale app's CLI as the VM specs need it: every call is recorded in
# $HOME/.calls; `status --json` answers answers/tailscale/status.json, `serve status
# --json` answers answers/tailscale/serve.json (else {}), and every other `serve` is
# recorded and succeeds unless answers/tailscale/serve.exit says otherwise.
answers="${0%/*}/../answers/tailscale"
printf 'tailscale %s\n' "$*" >> "$HOME/.calls"
case "$*" in
    "status --json") /bin/cat "$answers/status.json" ;;
    "serve status --json")
        if [ -f "$answers/serve.json" ]; then /bin/cat "$answers/serve.json"; else echo '{}'; fi
        ;;
    serve*)
        if [ -f "$answers/serve.exit" ]; then
            echo "serve: HTTPS is not enabled for this tailnet" >&2
            exit "$(/bin/cat "$answers/serve.exit")"
        fi
        ;;
    *)
        echo "stub tailscale: unexpected invocation: $*" >&2
        exit 97
        ;;
esac
