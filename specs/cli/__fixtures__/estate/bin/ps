#!/bin/sh
# ps in the two shapes status asks: top by CPU and top by memory. Like the real ps, it
# prints its decimals in the caller's locale.
dot=.
case "${LC_ALL:-${LC_NUMERIC:-$LANG}}" in fr_*) dot=, ;; esac
case "$*" in
    "-arcwwwxo pid,%cpu,comm") printf '  PID  %%CPU COMMAND\n  301  45%s5 Google Chrome Helper\n  302  12%s0 node\n' "$dot" "$dot" ;;
    "-amcwwwxo pid,rss,comm") printf '  PID    RSS COMMAND\n  302 2097152 node\n  301  524288 Google Chrome Helper\n' ;;
    *)
        echo "stub ps: unexpected invocation: $*" >&2
        exit 97
        ;;
esac
