#!/bin/sh
# gh auth status as this Mac printed it on 2026-11-03, its token replaced by the
# sentinel, which also goes to stderr; answers/accounts/gh.mode picks "out"
# (not logged in) or "slow" (silent for the seconds in answers/accounts/gh.slow).
printf 'gh %s\n' "$*" >> "$HOME/.calls"
mode=$(/bin/cat "$HOME/answers/accounts/gh.mode" 2>/dev/null)
case "$mode:$*" in
    "slow:auth status"*) /bin/sleep "$(/bin/cat "$HOME/answers/accounts/gh.slow")" ;;
    "out:auth status"*)
        echo "You are not logged into any GitHub hosts. To log in, run: gh auth login" >&2
        echo "token: SENTINELgho_0123456789abcdefghijklmnopqrstuvwxyzAB" >&2
        exit 1 ;;
    *"auth status --hostname github.com")
        echo "github.com"
        echo "  ✓ Logged in to github.com account jterrazz (keyring)"
        echo "  - Active account: true"
        echo "  - Git operations protocol: ssh"
        echo "  - Token: SENTINELgho_0123456789abcdefghijklmnopqrstuvwxyzAB"
        echo "  - Token scopes: 'gist', 'read:org', 'repo', 'workflow'"
        echo "debug SENTINELgho_0123456789abcdefghijklmnopqrstuvwxyzAB" >&2 ;;
    *) echo "stub gh: unexpected invocation: $*" >&2; exit 97 ;;
esac
