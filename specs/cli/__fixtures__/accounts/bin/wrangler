#!/bin/sh
printf 'wrangler %s\n' "$*" >> "$HOME/.calls"
case "$*" in
    whoami)
        echo " ⛅️ wrangler 4.45.0"
        echo "Getting User settings..."
        echo "👋 You are logged in with an OAuth Token, associated with the email admin@jterrazz.com."
        echo "Token: SENTINELgho_0123456789abcdefghijklmnopqrstuvwxyzAB"
        echo "┌──────────────┬──────────────────────────────────┐"
        echo "│ Account Name │ Account ID                       │"
        echo "├──────────────┼──────────────────────────────────┤"
        echo "│ studio       │ 0123456789abcdef0123456789abcdef │"
        echo "└──────────────┴──────────────────────────────────┘" ;;
    *) echo "stub wrangler: unexpected invocation: $*" >&2; exit 97 ;;
esac
