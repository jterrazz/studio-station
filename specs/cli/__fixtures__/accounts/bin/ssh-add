#!/bin/sh
printf 'ssh-add %s\n' "$*" >> "$HOME/.calls"
case "$*" in
    -l)
        echo "256 SHA256:76MCcfWNZv0Ixcc4fM0b6Ue1o8l7W1Xo0n3zKhK1Vy4 admin@jterrazz.com (ED25519)"
        echo "256 SHA256:Q1q2q3q4q5q6q7q8q9q0w1w2w3w4w5w6w7w8w9w0e1e station-image (ED25519)"
        echo "256 SHA256:R1r2r3r4r5r6r7r8r9r0t1t2t3t4t5t6t7t8t9t0y1y station-e2e (ED25519)"
        echo "256 SHA256:S1s2s3s4s5s6s7s8s9s0u1u2u3u4u5u6u7u8u9u0i1i deploy (ED25519)"
        echo "3072 SHA256:T1t2t3t4t5t6t7t8t9t0o1o2o3o4o5o6o7o8o9o0p1p old-rsa (RSA)"
        echo "256 SHA256:U1u2u3u4u5u6u7u8u9u0a1a2a3a4a5a6a7a8a9a0s1s github-actions (ED25519)" ;;
    *) echo "stub ssh-add: unexpected invocation: $*" >&2; exit 97 ;;
esac
