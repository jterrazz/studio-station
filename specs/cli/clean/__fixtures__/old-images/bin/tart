#!/bin/sh
# Tart holding the two built versions of linux: every call is recorded in $HOME/.calls.
printf 'tart %s\n' "$*" >> "$HOME/.calls"
case "$*" in
    "--version") echo "2.41.1" ;;
    "list --source local --format json")
        echo '[{"Source":"local","Name":"station-image-linux-2026.11.01","Disk":50,"Size":5,"State":"stopped"},{"Source":"local","Name":"station-image-linux-2026.11.07","Disk":50,"Size":5,"State":"stopped"}]'
        ;;
    "delete station-image-linux-2026.11.01" | "prune --entries=caches") ;;
    *)
        echo "stub tart: unexpected invocation: $*" >&2
        exit 97
        ;;
esac
