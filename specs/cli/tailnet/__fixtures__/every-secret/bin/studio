#!/bin/sh
# The OS's studio CLI: export answers a JSON object holding one stub value per name asked.
case "$1 $2" in
    "credentials export")
        shift 2
        sep='{'
        for name in "$@"; do
            printf '%s"%s":"stub-value-of-%s"' "$sep" "$name" "$name"
            sep=,
        done
        printf '}\n'
        ;;
    *)
        echo "stub studio: unexpected invocation: $*" >&2
        exit 97
        ;;
esac
