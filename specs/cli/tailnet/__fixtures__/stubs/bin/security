#!/bin/sh
# security answering find-generic-password from answers/security/<account>, exit 44 (not found) otherwise.
answers="${0%/*}/../answers/security"
printf 'security %s\n' "$*" >> "$HOME/.calls"
case "$*" in
    "find-generic-password -s station -a "*" -w")
        if [ -f "$answers/$5" ]; then
            /bin/cat "$answers/$5"
            exit 0
        fi
        exit 44
        ;;
    *)
        echo "stub security: unexpected invocation: $*" >&2
        exit 97
        ;;
esac
