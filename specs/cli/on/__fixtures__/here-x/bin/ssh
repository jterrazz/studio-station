#!/bin/sh
# ssh as the --on specs need it: the argv is recorded in $HOME/.calls, and the remote's
# stdout, stderr and exit code are answer files.
answers="${0%/*}/../answers/ssh"
printf 'ssh %s\n' "$*" >> "$HOME/.calls"
/bin/cat "$answers/stdout.txt"
/bin/cat "$answers/stderr.txt" >&2
exit "$(/bin/cat "$answers/exit")"
