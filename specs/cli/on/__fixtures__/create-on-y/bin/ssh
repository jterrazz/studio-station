#!/bin/sh
# ssh to host y: every call is recorded in $HOME/.calls; `machines create` there makes
# the VM linux-1, which y's fleet answer (`machines --here --json`) holds from then on.
printf 'ssh %s\n' "$*" >> "$HOME/.calls"
case "$*" in
    *"machines create"*)
        : > "$HOME/.created"
        printf '●\tlinux-1\tlasting\trunning\n'
        ;;
    *"machines --here --json"*)
        vms='[]'
        if [ -f "$HOME/.created" ]; then
            vms='[{"name":"linux-1","kind":"linux","image":"linux","version":"2026.11.07","lifetime":"lasting","state":"running","cpus":4,"memory_bytes":4294967296,"disk_bytes":50000000000,"created_at":"2026-11-07T10:00:00Z","node":{"online":true,"ip":"100.64.0.9"},"lent":[]}]'
        fi
        printf '{"schema":"station.machines/v1","hosts":[{"name":"y","here":true,"reachable":true,"station_version":"","user":"u","node":{"online":true,"ip":"100.64.0.2"},"vms":%s}]}\n' "$vms"
        ;;
    *)
        echo "stub ssh: unexpected invocation: $*" >&2
        exit 97
        ;;
esac
