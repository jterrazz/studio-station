#!/bin/sh
# ssh as the secrets specs need it (a delete exits with answers/ssh/delete.exit): every call is recorded in $HOME/.calls, the studio
# pre-check answers with the exit code in answers/ssh/studio.exit, and an import keeps
# its stdin in $HOME/imported.json (never in .calls, so no value shows in a call log).
answers="${0%/*}/../answers/ssh"
printf 'ssh %s\n' "$*" >> "$HOME/.calls"
case "$*" in
    *"command -v studio") exit "$(/bin/cat "$answers/studio.exit")" ;;
    *"studio credentials import") /bin/cat > "$HOME/imported.json" ;;
    *"studio credentials delete "*) exit "$(/bin/cat "$answers/delete.exit")" ;;
    *)
        echo "stub ssh: unexpected invocation: $*" >&2
        exit 97
        ;;
esac
