#!/bin/sh
# tailscale whose status answers once a tailscaled was started from the new folder; until
# then the daemon there is down.
printf 'tailscale %s\n' "$*" >> "$HOME/.calls"
case "$*" in
    *"/.local/state/station/tailscaled/tailscaled.sock status --json")
        # invariant: once station recorded the daemon's pid it started tailscaled, whose
        # own line may land a moment later.
        if [ -f "$HOME/.local/state/station/tailscaled/tailscaled.pid" ]; then
            tries=0
            until /usr/bin/grep -q '^tailscaled ' "$HOME/.calls" || [ "$tries" -ge 100 ]; do
                /bin/sleep 0.05
                tries=$((tries + 1))
            done
        fi
        if /usr/bin/grep -q '^tailscaled ' "$HOME/.calls"; then
            echo '{"BackendState":"Running","Self":{"ID":"n0","HostName":"base","TailscaleIPs":["100.64.0.1"],"Online":true}}'
            exit 0
        fi
        exit 1
        ;;
    *)
        echo "stub tailscale: unexpected invocation: $*" >&2
        exit 97
        ;;
esac
