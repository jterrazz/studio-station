#!/bin/sh
# Homebrew just installed: a bundle is recorded with its Brewfile and puts mise and
# tailscale on PATH, which its listing then shows.
case "$*" in
    "--version") echo "Homebrew 5.0.1" ;;
    "list --formula --versions") if [ -f "$HOME/bin/mise" ]; then printf 'mise 2026.10.25\ntailscale 1.90.6\n'; fi ;;
    "list --cask --versions") ;;
    "bundle install --no-upgrade --file=-")
        printf 'brew %s\n' "$*" >> "$HOME/.calls"
        /bin/cat >> "$HOME/.calls"
        /bin/cp "$HOME/later/version" "$HOME/bin/mise"
        /bin/cp "$HOME/later/version" "$HOME/bin/tailscale"
        ;;
    *)
        echo "stub brew: unexpected invocation: $*" >&2
        exit 97
        ;;
esac
