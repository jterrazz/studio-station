#!/bin/sh
# docker with its daemon stopped: every read status makes fails.
case "$*" in
    "system df --format {{.Size}}" | "images -q" | "images -f dangling=true --format {{.Size}}" | "ps -q" | "volume ls -q")
        echo "Cannot connect to the Docker daemon" >&2
        exit 1
        ;;
    *)
        echo "stub docker: unexpected invocation: $*" >&2
        exit 97
        ;;
esac
