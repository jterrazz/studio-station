#!/bin/sh
# Homebrew as status needs it: bat installed, nothing else, and the outdated list an answer file.
answers="${0%/*}/../answers/brew"
case "$*" in
    "--version") echo "Homebrew 5.0.1" ;;
    "list --formula --versions") /bin/cat "$answers/formula.txt" ;;
    "list --cask --versions") ;;
    "outdated --quiet")
        if [ -f "$answers/outdated.txt" ]; then /bin/cat "$answers/outdated.txt"; fi
        ;;
    *)
        echo "stub brew: unexpected invocation: $*" >&2
        exit 97
        ;;
esac
