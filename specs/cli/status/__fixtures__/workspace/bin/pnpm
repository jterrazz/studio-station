#!/bin/sh
# pnpm outdated exits 1 when something is outdated.
case "$*" in
    "outdated --dir "*" --format json")
        printf '{"left-pad":{"current":"1","latest":"2"},"lodash":{"current":"3","latest":"4"}}\n'
        exit 1
        ;;
    *)
        echo "stub ${0##*/}: unexpected invocation: $*" >&2
        exit 97
        ;;
esac
