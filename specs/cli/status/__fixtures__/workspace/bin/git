#!/bin/sh
# git as status reads it: per-repository status for api (two changes) and web (clean), the
# global identity, and a signing flag.
case "$*" in
    "-C "*"/api status --porcelain -b") printf '## main...origin/main [ahead 1]\n M a.go\n?? b.go\n' ;;
    "-C "*"/web status --porcelain -b") printf '## feat/x\n' ;;
    "-C "*"/tool status --porcelain -b") printf '## No commits yet on main\n' ;;
    "config --global user.email") echo admin@jterrazz.com ;;
    "config --global user.name") echo "Someone Else" ;;
    "config --global commit.gpgsign") echo true ;;
    --version) echo "git version 2.51.0" ;;
    *)
        echo "stub ${0##*/}: unexpected invocation: $*" >&2
        exit 97
        ;;
esac
