#!/bin/sh
# ping that finds its host unless answers/ping.exit says otherwise, recorded in $HOME/.calls.
printf 'ping %s\n' "$*" >> "$HOME/.calls"
case "$*" in
    "-c 1 -W 1000 "*)
        if [ -f "${0%/*}/../answers/ping.exit" ]; then exit "$(/bin/cat "${0%/*}/../answers/ping.exit")"; fi
        ;;
    *)
        echo "stub ping: unexpected invocation: $*" >&2
        exit 97
        ;;
esac
