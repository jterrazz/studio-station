#!/bin/sh
# go as it cleans for real: the build cache is emptied, then its README and
# trim.txt are written back, which go does on every open of that cache.
case "$1" in
    --version | version) echo "go version go1.25.3 linux/arm64" ;;
    clean)
        printf 'go %s\n' "$*" >> "$HOME/.calls"
        /bin/rm -rf "$HOME/.cache/go-build"
        /bin/mkdir -p "$HOME/.cache/go-build"
        echo "This directory holds cached build artifacts from the Go build system." > "$HOME/.cache/go-build/README"
        echo "1761955200" > "$HOME/.cache/go-build/trim.txt"
        ;;
    *)
        echo "stub go: unexpected invocation: $*" >&2
        exit 97
        ;;
esac
