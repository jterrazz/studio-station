#!/bin/sh
# npm as it cleans for real: only its own _cacache goes; what bun wrote beside it
# (bun reads the npmrc's cache=) stays.
case "$1 $2" in
    "cache clean")
        printf 'npm %s\n' "$*" >> "$HOME/.calls"
        /bin/rm -rf "$HOME/.cache/npm/_cacache"
        ;;
    *)
        echo "stub npm: unexpected invocation: $*" >&2
        exit 97
        ;;
esac
