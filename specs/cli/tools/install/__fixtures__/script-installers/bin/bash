#!/bin/sh
# bash as a curl installer meets it: each argument recorded in brackets, then the
# variables that keep the installer from touching ~/.zshrc.
case "$1 $2" in
    "-c script=\"\$(curl -fsSL \"\$0\")\" && exec bash -c \"\$script\" bash \"\$@\"") ;;
    *)
        echo "stub bash: unexpected invocation: $*" >&2
        exit 97
        ;;
esac
line='bash'
for arg in "$@"; do line="$line [$arg]"; done
printf '%s env RUNZSH=%s CHSH=%s KEEP_ZSHRC=%s\n' "$line" "$RUNZSH" "$CHSH" "$KEEP_ZSHRC" >> "$HOME/.calls"
