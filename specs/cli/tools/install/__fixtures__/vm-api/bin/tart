#!/bin/sh
# Tart with one running VM, api: `list` is the only question a refusal asks it.
printf 'tart %s\n' "$*" >> "$HOME/.calls"
case "$*" in
    "list --source local --format json")
        echo '[{"Source":"local","Name":"api","Disk":50,"Size":12,"State":"running"},{"Source":"local","Name":"old","Disk":50,"Size":12,"State":"stopped"}]'
        ;;
    *)
        echo "stub tart: unexpected invocation: $*" >&2
        exit 97
        ;;
esac
