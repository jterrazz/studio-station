#!/bin/sh
# git as the run specs need it: every argv is recorded one word per <..>, so a message that
# reached git as ONE word is told from one split in two; `status` prints a line, and
# answers/git/<verb>.exit makes a verb fail.
answers="${0%/*}/../answers/git"
printf 'git' >> "$HOME/.calls"
for word in "$@"; do printf ' <%s>' "$word" >> "$HOME/.calls"; done
printf '\n' >> "$HOME/.calls"
case "$*" in
    "add --all" | "add ." | branch | "commit -m "* | "fetch -p" | "log --oneline -10" | pull | "push -u origin HEAD" | "reset --soft HEAD~1" | "reset HEAD") ;;
    status) echo "On branch main" ;;
    *)
        echo "stub git: unexpected invocation: $*" >&2
        exit 97
        ;;
esac
if [ -f "$answers/$1.exit" ]; then
    echo "fatal: $1 failed" >&2
    exit "$(/bin/cat "$answers/$1.exit")"
fi
