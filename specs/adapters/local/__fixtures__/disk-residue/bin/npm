#!/bin/sh
# A mise shim: every call writes mise's bin_paths resolver file back.
/bin/mkdir -p "$HOME/.cache/mise/jq/1.8.2" && printf '0123456789' > "$HOME/.cache/mise/jq/1.8.2/bin_paths-e6c40.msgpack.z"
# npm as it cleans for real: only its own _cacache goes; what bun wrote beside it
# (bun reads the npmrc's cache=) stays.
case "$1 $2" in
    "cache clean")
        printf 'npm %s\n' "$*" >> "$HOME/.calls"
        /bin/rm -rf "$HOME/.cache/npm/_cacache"
        ;;
    *)
        echo "stub npm: unexpected invocation: $*" >&2
        exit 97
        ;;
esac
