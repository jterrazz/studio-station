#!/bin/sh
# npm whoami; answers/accounts/npm.mode picks "e401" (the registry refuses the
# stored token) or "eneedauth" (no login); the sentinel always goes to stderr.
printf 'npm %s\n' "$*" >> "$HOME/.calls"
mode=$(/bin/cat "$HOME/answers/accounts/npm.mode" 2>/dev/null)
echo "npm notice token SENTINELgho_0123456789abcdefghijklmnopqrstuvwxyzAB" >&2
case "$mode:$*" in
    "e401:whoami") echo "npm error code E401" >&2; echo "npm error 401 Unauthorized - token SENTINELgho_0123456789abcdefghijklmnopqrstuvwxyzAB" >&2; exit 1 ;;
    "eneedauth:whoami") echo "npm error code ENEEDAUTH" >&2; exit 1 ;;
    *":whoami") echo jterrazz ;;
    *) echo "stub npm: unexpected invocation: $*" >&2; exit 97 ;;
esac
