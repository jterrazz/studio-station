#!/bin/sh
# bash as a curl installer meets it: each argument recorded in brackets, then the
# variables that keep the installer from touching ~/.zshrc. Homebrew's installer puts
# brew where the real one does, under the system root's /opt/homebrew/bin, which is
# on no PATH; Claude's puts claude in ~/.local/bin, on no PATH either, after calling
# brew by name as a later step of the run does; every other installer leaves nothing.
case "$1 $2" in
    "-c script=\"\$(curl -fsSL \"\$0\")\" && exec bash -c \"\$script\" bash \"\$@\"") ;;
    *)
        echo "stub bash: unexpected invocation: $*" >&2
        exit 97
        ;;
esac
line='bash'
for arg in "$@"; do line="$line [$arg]"; done
printf '%s env RUNZSH=%s CHSH=%s KEEP_ZSHRC=%s\n' "$line" "$RUNZSH" "$CHSH" "$KEEP_ZSHRC" >> "$HOME/.calls"
case "$*" in
    *Homebrew/install*)
        /bin/mkdir -p "$STATION_SYSTEM_ROOT/opt/homebrew/bin"
        /bin/cp "$HOME/later/brew" "$STATION_SYSTEM_ROOT/opt/homebrew/bin/brew"
        ;;
    *claude.ai/install*)
        brew --version >> "$HOME/.calls"
        /bin/mkdir -p "$HOME/.local/bin"
        printf '#!/bin/sh\necho 2.1.0\n' > "$HOME/.local/bin/claude"
        /bin/chmod +x "$HOME/.local/bin/claude"
        ;;
esac
