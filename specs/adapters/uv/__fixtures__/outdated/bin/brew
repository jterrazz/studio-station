#!/bin/sh
# Homebrew for uv's update: a bundle updates what its Brewfile names, so the listing it was
# given replaces the old and nothing is outdated.
answers="${0%/*}/../answers/uv"
printf 'brew %s\n' "$*" >> "$HOME/.calls"
case "$*" in
    "--version") echo "Homebrew 5.0.1" ;;
    "list --formula --versions" | "list --cask --versions") ;;
    "bundle install --upgrade --file=-")
        /bin/cat >> "$HOME/.calls"
        /bin/cp "$answers/list.after.txt" "$answers/list.txt"
        /bin/cp "$answers/list.after.txt" "$answers/outdated.txt"
        ;;
    *)
        echo "stub brew: unexpected invocation: $*" >&2
        exit 97
        ;;
esac
