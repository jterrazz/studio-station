#!/bin/sh
# bash as the installers meet it: each call recorded, and each installer puts its tool on
# PATH as the real one would: Homebrew's script brew, the CLT git, the tart line tart.
# Anything but `bash -c` exits 97.
line='bash'
for arg in "$@"; do line="$line [$arg]"; done
printf '%s\n' "$line" >> "$HOME/.calls"
[ "$1" = -c ] || exit 97
case "$*" in
    *Homebrew/install*) /bin/cp "$HOME/later/brew" "$HOME/bin/brew" ;;
    *xcode-select*) /bin/cp "$HOME/later/version" "$HOME/bin/git" ;;
    *tart.tar.gz*) /bin/cp "$HOME/later/version" "$HOME/bin/tart" ;;
esac
