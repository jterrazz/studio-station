#!/bin/sh
# Homebrew just installed: a bundle is recorded with its Brewfile, says it started, and
# then waits as a cask does at its sudo prompt, so Ctrl-C reaches it mid-bundle.
case "$*" in
    "--version") echo "Homebrew 5.0.1" ;;
    "list --formula --versions") if [ -f "$HOME/bin/mise" ]; then printf 'mise 2026.10.25\n'; fi ;;
    "list --cask --versions") if [ -f "$HOME/bin/tailscale" ]; then printf 'tailscale-app 1.90.6\n'; fi ;;
    "bundle install --no-upgrade --file=-")
        printf 'brew %s\n' "$*" >> "$HOME/.calls"
        /bin/cat >> "$HOME/.calls"
        echo started > "$HOME/bundle-started"
        /bin/sleep 25
        ;;
    *)
        echo "stub brew: unexpected invocation: $*" >&2
        exit 97
        ;;
esac
