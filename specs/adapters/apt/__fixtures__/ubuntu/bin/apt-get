#!/bin/sh
# apt-get: simulates a removal (what depends lists comes with it), refuses a change that is not root's,
# noninteractive and keeping changed configuration, and writes dpkg.db; while the file hang is there, an
# install that wrote dpkg.db writes apt-hung, then waits to be interrupted.
printf 'apt-get %s\n' "$*" >> "$HOME/.calls"
db="$HOME/dpkg.db"
touch "$db"
if [ "$1" = -s ]; then
    shift 2
    for p in "$@"; do
        case "$p" in -o | APT::* | --) continue ;; esac
        echo "Remv $p [1.0]"
        /usr/bin/awk -F'\t' -v p="$p" '$1 == p { print "Remv " $2 " [1.0]" }' "$HOME/depends" 2>/dev/null
    done
    exit 0
fi
if [ "$DEBIAN_FRONTEND" != noninteractive ]; then
    echo "stub apt-get: run as root, noninteractive: $*" >&2
    exit 98
fi
while [ "$1" = -y ] || [ "$1" = -o ]; do
    [ "$1" = -o ] && shift
    shift
done
verb="$1"
shift
upgrade=0
for p in "$@"; do
    case "$p" in
        --only-upgrade) upgrade=1 ;;
        -o | APT::* | --) ;;
        *)
            name="${p%%=*}"
            version="${p#*=}"
            [ "$version" = "$p" ] && version=1.0
            if [ "$upgrade" = 1 ]; then
                version=$(/usr/bin/awk -F'\t' -v p="$name" '$1 == p { print $2 }' "$HOME/candidates" 2>/dev/null)
                [ -n "$version" ] || continue
            fi
            if [ "$verb" = install ] && [ -f "$HOME/missing" ] && /usr/bin/grep -qx "$name" "$HOME/missing"; then
                echo "E: Unable to locate package $name" >&2
                exit 100
            fi
            /usr/bin/awk -F'\t' -v p="$name" '$1 != p' "$db" > "$db.new" && /bin/mv "$db.new" "$db"
            [ "$verb" = install ] && printf '%s\t%s\n' "$name" "$version" >> "$db"
            ;;
    esac
done
if [ "$verb" = install ] && [ -f "$HOME/hang" ]; then
    echo hung > "$HOME/apt-hung"
    exec /bin/sleep 20
fi
case "$verb" in install | remove | update) ;; *) echo "stub apt-get: unexpected $verb" >&2; exit 97 ;; esac
