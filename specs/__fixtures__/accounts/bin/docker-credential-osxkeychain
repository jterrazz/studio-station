#!/bin/sh
# list answers registry to username; get would print a secret and must never run.
printf 'docker-credential-osxkeychain %s\n' "$*" >> "$HOME/.calls"
case "$*" in
    list) echo '{"https://registry.jterrazz.com":"deploy"}' ;;
    get) echo '{"Secret":"SENTINELgho_0123456789abcdefghijklmnopqrstuvwxyzAB"}' ;;
    *) echo "stub docker-credential-osxkeychain: unexpected invocation: $*" >&2; exit 97 ;;
esac
