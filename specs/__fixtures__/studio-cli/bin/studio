#!/bin/sh
# studio as the shell specs need it: `credentials export` answers the lent token and records
# the backend it was told to use, so the file store (a VM has no keychain) is proved.
printf '%s studio %s\n' "STUDIO_CREDENTIALS_BACKEND=$STUDIO_CREDENTIALS_BACKEND" "$*" >> "$HOME/.calls"
case "$*" in
    "credentials export operator:claude:oauth-token")
        if [ -f "${0%/*}/../answers/studio/export.exit" ]; then exit "$(/bin/cat "${0%/*}/../answers/studio/export.exit")"; fi
        /bin/cat "${0%/*}/../answers/studio/export.json"
        ;;
    *)
        echo "stub studio: unexpected invocation: $*" >&2
        exit 97
        ;;
esac
