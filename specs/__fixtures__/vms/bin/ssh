#!/bin/sh
# ssh as the VM specs need it: every call's argv is recorded in $HOME/.calls; a host
# answers the fleet fan-out from answers/ssh/fleet-<host>.json and services-<host>.json
# (else 255), and releases a service as the remote host's station does. Over the
# NAT (an argv holding `-i`): the first boot keeps its stdin in $HOME/.firstboot.stdin
# (answers/ssh/firstboot.exit fails it); a poweroff stops every running VM and exits
# 255. `<name> true` checks the host key in known_hosts/<name> against answers/ssh/hostkey, as
# StrictHostKeyChecking=accept-new does. `station accounts` over --on answers as the
# station of the document's vm/ folder does. Anything else exits 97.
answers="${0%/*}/../answers/ssh"
printf 'ssh %s\n' "$*" >> "$HOME/.calls"
case "$*" in
    *"machines --here --json"*)
        prev=''
        for arg; do
            if [ "$arg" = -- ]; then target=$prev; break; fi
            prev=$arg
        done
        if [ -f "$answers/fleet-$target.json" ]; then /bin/cat "$answers/fleet-$target.json"; exit 0; fi
        exit 255
        ;;
    *"services --here --json"*)
        prev=''
        for arg; do
            if [ "$arg" = -- ]; then target=$prev; break; fi
            prev=$arg
        done
        if [ -f "$answers/services-$target.json" ]; then /bin/cat "$answers/services-$target.json"; exit 0; fi
        exit 255
        ;;
    *"services release "*)
        for arg; do [ "$arg" = --yes ] || target=$arg; done
        printf '●\t%s\treleased\n' "$target"
        ;;
    *" -i "*"sudo bash -s")
        /bin/cat > "$HOME/.firstboot.stdin"
        if [ -f "$answers/firstboot.exit" ]; then exit "$(/bin/cat "$answers/firstboot.exit")"; fi
        ;;
    *" -i "*"sudo systemctl --no-block poweroff")
        for vm in "$HOME"/.tart-vms/*; do
            [ "$(/bin/cat "$vm")" = running ] && echo stopped > "$vm" && /bin/mkdir -p "$HOME/.tart-intents" && : > "$HOME/.tart-intents/${vm##*/}"
        done
        exit 255
        ;;
    *" true")
        eval "name=\${$(($# - 1))}"
        known="$HOME/.local/state/station/known_hosts/$name"
        key=$(/bin/cat "$answers/hostkey")
        if [ -f "$known" ] && ! /usr/bin/grep -qF "$key" "$known"; then
            echo "@@@@ WARNING: REMOTE HOST IDENTIFICATION HAS CHANGED! @@@@" >&2
            exit 255
        fi
        /bin/mkdir -p "${known%/*}"
        echo "$name $key" >> "$known"
        ;;
    *"exec station \"\$@\"' station accounts"*)
        [ -x "$HOME/vm/bin/station" ] || { echo "stub ssh: no vm/ to answer: $*" >&2; exit 97; }
        while [ "$1" != station ]; do shift; done
        shift
        cd "$HOME/vm" && exec /usr/bin/env -i HOME="$HOME/vm" PATH="$HOME/vm/bin" STATION="$STATION" TZ=UTC "$HOME/vm/bin/station" "$@"
        ;;
    *)
        echo "stub ssh: unexpected invocation: $*" >&2
        exit 97
        ;;
esac
