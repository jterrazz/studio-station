#!/bin/sh
# A VM's credential store as the studio CLI's file backend keeps it: import reads
# the secrets on stdin, export prints them, delete forgets them.
store="$HOME/.local/state/e2e-studio.json"
[ "$1" = credentials ] || { echo "stub studio: unexpected invocation: $*" >&2; exit 97; }
case "$2" in
    import) mkdir -p "${store%/*}" && cat > "$store" ;;
    export) [ -f "$store" ] || { echo "credential $3 not found" >&2; exit 1; }; cat "$store" ;;
    delete) rm -f "$store" ;;
    *) echo "stub studio: unexpected invocation: $*" >&2; exit 97 ;;
esac
