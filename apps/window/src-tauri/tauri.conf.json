{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Station",
    "version": "0.1.0",
    "identifier": "com.jterrazz.station.window",
    "build": {
        "frontendDist": "../dist",
        "devUrl": "http://localhost:1420",
        "beforeDevCommand": "npm run dev",
        "beforeBuildCommand": "npm run build"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "Station",
                "width": 1440,
                "height": 1000,
                "minWidth": 1100,
                "minHeight": 700,
                "titleBarStyle": "Overlay",
                "hiddenTitle": true,
                "trafficLightPosition": { "x": 18, "y": 25.5 },
                "theme": "Dark",
                "transparent": true,
                "windowEffects": {
                    "effects": ["underWindowBackground"],
                    "state": "followsWindowActiveState"
                }
            }
        ],
        "security": { "csp": "default-src 'self'; font-src 'self' data:; img-src 'self' data:" }
    },
    "bundle": { "active": false, "icon": ["icons/icon.png"] }
}
