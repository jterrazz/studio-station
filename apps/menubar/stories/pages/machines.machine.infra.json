  "actions": [
    {
      "label": "Restart",
      "on": "page",
      "priority": 1,
      "mutates": true,
      "id": "restart",
      "run": {
        "call": "machines.restart",
        "in": {
          "Name": "infra"
        },
        "target": {
          "name": "mac-mini"
        }
      }
    },
    {
      "label": "Stop",
      "on": "page",
      "confirm": {
        "question": "Stop infra?",
        "lines": [
          {
            "kind": "text",
            "text": "It stays stopped until you start it: the engine no longer restarts it."
          },
          {
            "kind": "text",
            "text": "Type infra to stop it."
          }
        ],
        "danger": true,
        "type": "infra",
        "yes": "Stop"
      },
      "priority": 2,
      "mutates": true,
      "id": "stop",
      "run": {
        "call": "machines.stop",
        "in": {
          "VM": "infra"
        },
        "target": {
          "name": "mac-mini"
        }
      }
    },
    {
      "key": "cmd+t",
      "label": "Open in Terminal",
      "on": "page",
      "priority": 2,
      "id": "open-station",
      "run": {
        "terminal": true,
        "argv": [
          "--on",
          "infra"
        ]
      }
    }
