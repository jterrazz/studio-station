  "actions": [
    {
      "label": "Stop",
      "on": "page",
      "confirm": {
        "question": "Stop api?",
        "lines": [
          {
            "kind": "text",
            "text": "Its disk is kept."
          }
        ],
        "yes": "Stop"
      },
      "priority": 1,
      "mutates": true,
      "id": "stop",
      "run": {
        "call": "machines.stop",
        "in": {
          "Confirm": "yes",
          "VM": "api"
        }
      }
    },
    {
      "label": "Delete",
      "on": "page",
      "confirm": {
        "question": "Delete api?",
        "lines": [
          {
            "kind": "text",
            "text": "Its disk is erased: nothing of it is kept."
          },
          {
            "kind": "text",
            "text": "Type api to delete it."
          }
        ],
        "danger": true,
        "type": "api",
        "yes": "Delete"
      },
      "priority": 2,
      "mutates": true,
      "id": "delete",
      "run": {
        "call": "machines.delete",
        "in": {
          "VM": "api"
        }
      }
    },
    {
      "key": "shift+cmd+n",
      "label": "New agent",
      "on": "page",
      "priority": 2,
      "mutates": true,
      "id": "new-agent",
      "run": {
        "call": "agents.start",
        "in": {
          "On": "api"
        }
      },
      "form": {
        "title": "New agent on api",
        "fields": [
          {
            "key": "Task",
            "label": "Task",
            "kind": "text",
            "note": "empty, it waits for a prompt"
          }
        ]
      },
      "icon": "plus"
    },
    {
      "label": "Share a port",
      "on": "page",
      "priority": 3,
      "mutates": true,
      "id": "share-port",
      "run": {
        "call": "ports.share",
        "in": {
          "VM": "api"
        }
      },
      "form": {
        "title": "Share a port of api",
        "fields": [
          {
            "key": "Port",
            "label": "Port",
            "kind": "text",
            "note": "a port number, like 5173",
            "required": true
          }
        ]
      }
    },
    {
      "label": "Lend an account",
      "on": "row",
      "rows": [
        "share-account"
      ],
      "mutates": true,
      "id": "share-account",
      "run": {
        "call": "accounts.share"
      },
      "form": {
        "title": "Lend an account",
        "fields": [
          {
            "key": "With",
            "label": "To",
            "kind": "text",
            "default": "api",
            "required": true
          },
          {
            "key": "Account",
            "label": "Account",
            "kind": "text",
            "required": true
          },
          {
            "key": "For",
            "label": "For",
            "kind": "segmented",
            "options": [
              {
                "value": "14400000000000",
                "label": "4 hr"
              },
              {
                "value": "43200000000000",
                "label": "12 hr"
              },
              {
                "value": "604800000000000",
                "label": "7 days"
              }
            ],
            "default": "14400000000000"
          }
        ],
        "subtitle": "From This Mac. It ends by itself."
      },
      "sheet": "share-account",
      "prefill": {
        "With": "api"
      }
    },
    {
      "key": "cmd+enter",
      "label": "Open in Terminal",
      "on": "page",
      "priority": 2,
      "id": "open-station",
      "run": {
        "terminal": true,
        "argv": [
          "--on",
          "api"
        ]
      },
      "icon": "terminal",
      "hud": {
        "kind": "list",
        "items": [
          {
            "kind": "text",
            "text": "api opened in Terminal"
          }
        ]
      }
    },
    {
      "label": "Copy ssh api",
      "on": "page",
      "priority": 4,
      "id": "copy-ssh",
      "run": {
        "copy": "ssh api"
      },
      "icon": "doc.on.doc",
      "hud": {
        "kind": "list",
        "items": [
          {
            "kind": "text",
            "text": "Copied ssh api"
          }
        ]
      }
    },
    {
      "label": "More options for api",
      "on": "page",
      "id": "menu",
      "icon": "ellipsis",
      "submenu": [
        "share-port",
        "stop",
        "delete"
      ]
    }
  ],
  "header": {
    "back": "All machines",
