  "actions": [
    {
      "label": "Stop",
      "on": "page",
      "confirm": {
        "question": "Stop api?",
        "lines": [
          {
            "kind": "text",
            "text": "Its disk is kept."
          }
        ],
        "yes": "Stop"
      },
      "priority": 1,
      "mutates": true,
      "id": "stop",
      "run": {
        "call": "machines.stop",
        "in": {
          "Confirm": "yes",
          "VM": "api"
        }
      }
    },
    {
      "label": "Delete",
      "on": "page",
      "confirm": {
        "question": "Delete api?",
        "lines": [
          {
            "kind": "text",
            "text": "Its disk is erased: nothing of it is kept."
          },
          {
            "kind": "text",
            "text": "Type api to delete it."
          }
        ],
        "danger": true,
        "type": "api",
        "yes": "Delete"
      },
      "priority": 2,
      "mutates": true,
      "id": "delete",
      "run": {
        "call": "machines.delete",
        "in": {
          "VM": "api"
        }
      }
    },
    {
      "key": "shift+cmd+n",
      "label": "New agent",
      "on": "page",
      "priority": 2,
      "mutates": true,
      "id": "new-agent",
      "run": {
        "call": "agents.start",
        "in": {
          "On": "api"
        }
      },
      "form": {
        "title": "New agent on api",
        "fields": [
          {
            "key": "Task",
            "label": "Task",
            "kind": "text",
            "note": "empty, it waits for a prompt"
          }
        ]
      },
      "icon": "plus"
    },
    {
      "label": "Share a port",
      "on": "page",
      "priority": 3,
      "mutates": true,
      "id": "share-port",
      "run": {
        "call": "ports.share",
        "in": {
          "VM": "api"
        }
      },
      "form": {
        "title": "Share a port of api",
        "fields": [
          {
            "key": "Port",
            "label": "Port",
            "kind": "text",
            "note": "a port number, like 5173",
            "required": true
          }
        ]
      }
    },
    {
      "key": "cmd+enter",
      "label": "Open in Terminal",
      "on": "page",
      "priority": 2,
      "id": "open-station",
      "run": {
        "terminal": true,
        "argv": [
          "--on",
          "api"
        ]
      }
    },
    {
      "label": "More options for api",
      "on": "page",
      "id": "menu",
      "icon": "ellipsis",
      "submenu": [
        "stop",
        "delete"
      ]
    }
