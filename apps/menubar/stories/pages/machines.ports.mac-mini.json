{
  "schema": "station.page/v1",
  "id": "menubar.ports",
  "command": "menubar",
  "context": {
    "machine": "macbook-pro",
    "kind": "mac"
  },
  "state": "ready",
  "sections": [
    {
      "id": "summary",
      "title": "Ports",
      "role": "summary",
      "caption": [
        {
          "kind": "text",
          "text": "mac-mini"
        },
        {
          "kind": "text",
          "text": "1 public"
        },
        {
          "kind": "text",
          "text": "3 on your tailnet"
        }
      ]
    },
    {
      "id": "public",
      "title": "Public",
      "caption": [
        {
          "kind": "text",
          "text": "1"
        }
      ],
      "columns": [
        {
          "key": "name",
          "kind": "text",
          "keep": 100
        },
        {
          "key": "value",
          "kind": "list",
          "keep": 60
        }
      ],
      "items": [
        {
          "row": {
            "id": "infra:443",
            "mark": "ok",
            "label": "Traefik",
            "detail": {
              "kind": "list",
              "items": [
                {
                  "kind": "text",
                  "text": "infra:443"
                },
                {
                  "kind": "text",
                  "text": "Cloudflare Tunnel"
                }
              ]
            },
            "glyph": {
              "kind": "port:traefik"
            },
            "mac": "infra",
            "verb": "copy-port:infra:443"
          }
        }
      ],
      "counts": [
        {
          "mark": "ok",
          "n": 1
        }
      ],
      "glance": [
        {
          "kind": "text",
          "text": "Public"
        },
        {
          "kind": "text",
          "text": "from outside"
        }
      ]
    },
    {
      "id": "private",
      "title": "Private",
      "caption": [
        {
          "kind": "text",
          "text": "3"
        }
      ],
      "columns": [
        {
          "key": "name",
          "kind": "text",
          "keep": 100
        },
        {
          "key": "value",
          "kind": "list",
          "keep": 60
        }
      ],
      "items": [
        {
          "row": {
            "id": "infra:6443",
            "mark": "ok",
            "label": "Kubernetes API",
            "detail": {
              "kind": "text",
              "text": "infra:6443"
            },
            "glyph": {
              "kind": "port:kubernetes"
            },
            "verb": "copy-port:infra:6443"
          }
        },
        {
          "row": {
            "id": "linux-3:8080",
            "mark": "ok",
            "label": "Port 8080",
            "detail": {
              "kind": "text",
              "text": "linux-3:8080"
            },
            "glyph": {
              "kind": "port:web"
            },
            "verb": "open-port:linux-3:8080",
            "quick": "qr:linux-3:8080",
            "menu": [
              "open-port:linux-3:8080",
              "copy-port:linux-3:8080",
              "qr:linux-3:8080",
              "-",
              "stop-sharing:linux-3:8080"
            ]
          }
        },
        {
          "row": {
            "id": "mac-mini:5900",
            "mark": "ok",
            "label": "Screen Sharing",
            "detail": {
              "kind": "text",
              "text": "mac-mini:5900"
            },
            "glyph": {
              "kind": "port:web"
            },
            "verb": "copy-port:mac-mini:5900"
          }
        }
      ],
      "counts": [
        {
          "mark": "ok",
          "n": 3
        }
      ],
      "glance": [
        {
          "kind": "text",
          "text": "Private"
        },
        {
          "kind": "text",
          "text": "on your tailnet"
        }
      ]
    },
    {
      "id": "listening",
      "title": "Listening, not shared",
      "caption": [
        {
          "kind": "text",
          "text": "2"
        }
      ],
      "columns": [
        {
          "key": "name",
          "kind": "text",
          "keep": 100
        },
        {
          "key": "value",
          "kind": "list",
          "keep": 60
        }
      ],
      "items": [
        {
          "row": {
            "id": "linux-3:5432",
            "mark": "ok",
            "label": "Postgres",
            "detail": {
              "kind": "text",
              "text": "linux-3:5432"
            },
            "glyph": {
              "kind": "port:postgres"
            },
            "verb": "share:linux-3:5432"
          }
        },
        {
          "row": {
            "id": "review-bot:8000",
            "mark": "ok",
            "label": "Port 8000",
            "detail": {
              "kind": "text",
              "text": "review-bot:8000"
            },
            "glyph": {
              "kind": "port:web"
            },
            "verb": "share:review-bot:8000"
          }
        }
      ],
      "counts": [
        {
          "mark": "ok",
          "n": 2
        }
      ]
    }
  ],
  "actions": [
    {
      "label": "Open Port 8080",
      "on": "row",
      "rows": [
        "linux-3:8080"
      ],
      "id": "open-port:linux-3:8080",
      "run": {
        "open": "https://mac-mini.tail77a797.ts.net:40001"
      }
    },
    {
      "label": "Copy link to Port 8080",
      "on": "row",
      "rows": [
        "linux-3:8080"
      ],
      "id": "copy-port:linux-3:8080",
      "run": {
        "copy": "https://mac-mini.tail77a797.ts.net:40001"
      },
      "hud": {
        "kind": "list",
        "items": [
          {
            "kind": "text",
            "text": "Copied https://mac-mini.tail77a797.ts.net:40001"
          }
        ]
      }
    },
    {
      "label": "Show QR for Port 8080",
      "on": "row",
      "rows": [
        "linux-3:8080"
      ],
      "id": "qr:linux-3:8080",
      "icon": "qrcode"
    },
    {
      "label": "Stop sharing",
      "on": "row",
      "rows": [
        "linux-3:8080"
      ],
      "confirm": {
        "question": "Stop sharing linux-3's port 8080?",
        "lines": [
          {
            "kind": "text",
            "text": "Its link stops working on Tailscale, and reserved port 40001 is let go."
          }
        ],
        "danger": true,
        "yes": "Stop sharing",
        "no": "Cancel"
      },
      "priority": 3,
      "mutates": true,
      "id": "stop-sharing:linux-3:8080",
      "run": {
        "call": "ports.stop-sharing",
        "in": {
          "Confirm": "yes",
          "Mac": "\"mac-mini\"",
          "Port": "\"8080\"",
          "VM": "\"linux-3\""
        }
      }
    },
    {
      "label": "Copy link to Traefik",
      "on": "row",
      "rows": [
        "infra:443"
      ],
      "id": "copy-port:infra:443",
      "run": {
        "copy": "infra:443"
      },
      "hud": {
        "kind": "list",
        "items": [
          {
            "kind": "text",
            "text": "Copied infra:443"
          }
        ]
      }
    },
    {
      "label": "Copy link to Kubernetes API",
      "on": "row",
      "rows": [
        "infra:6443"
      ],
      "id": "copy-port:infra:6443",
      "run": {
        "copy": "infra:6443"
      },
      "hud": {
        "kind": "list",
        "items": [
          {
            "kind": "text",
            "text": "Copied infra:6443"
          }
        ]
      }
    },
    {
      "label": "Share",
      "on": "row",
      "rows": [
        "linux-3:5432"
      ],
      "mutates": true,
      "id": "share:linux-3:5432",
      "run": {
        "call": "ports.share",
        "in": {
          "Port": "5432",
          "VM": "linux-3"
        },
        "target": {
          "name": "mac-mini"
        }
      },
      "hud": {
        "kind": "list",
        "items": [
          {
            "kind": "text",
            "text": "Shared Postgres of linux-3"
          }
        ]
      }
    },
    {
      "label": "Share",
      "on": "row",
      "rows": [
        "review-bot:8000"
      ],
      "mutates": true,
      "id": "share:review-bot:8000",
      "run": {
        "call": "ports.share",
        "in": {
          "Port": "8000",
          "VM": "review-bot"
        },
        "target": {
          "name": "mac-mini"
        }
      },
      "hud": {
        "kind": "list",
        "items": [
          {
            "kind": "text",
            "text": "Shared Port 8000 of review-bot"
          }
        ]
      }
    },
    {
      "label": "Copy link to Screen Sharing",
      "on": "row",
      "rows": [
        "mac-mini:5900"
      ],
      "id": "copy-port:mac-mini:5900",
      "run": {
        "copy": "mac-mini:5900"
      },
      "hud": {
        "kind": "list",
        "items": [
          {
            "kind": "text",
            "text": "Copied mac-mini:5900"
          }
        ]
      }
    },
    {
      "label": "Declare public",
      "on": "page",
      "priority": 2,
      "mutates": true,
      "id": "declare-public",
      "run": {
        "call": "ports.declare"
      },
      "form": {
        "title": "Declare a port public",
        "fields": [
          {
            "key": "Port",
            "label": "Port",
            "kind": "select",
            "options": [
              {
                "value": "Machine=\"infra\" Port=\"6443\"",
                "label": "infra:6443"
              },
              {
                "value": "Machine=\"linux-3\" Port=\"5432\"",
                "label": "linux-3:5432"
              },
              {
                "value": "Machine=\"review-bot\" Port=\"8000\"",
                "label": "review-bot:8000"
              },
              {
                "value": "Machine=\"mac-mini\" Port=\"5900\"",
                "label": "mac-mini:5900"
              }
            ],
            "default": "Machine=\"infra\" Port=\"6443\"",
            "required": true
          },
          {
            "key": "Via",
            "label": "Via",
            "kind": "select",
            "options": [
              {
                "value": "cloudflare-tunnel",
                "label": "Cloudflare Tunnel"
              },
              {
                "value": "tailscale-funnel",
                "label": "Tailscale Funnel"
              },
              {
                "value": "lan",
                "label": "your LAN"
              }
            ],
            "default": "cloudflare-tunnel",
            "required": true
          }
        ]
      }
    },
    {
      "label": "Share a port",
      "on": "page",
      "priority": 3,
      "mutates": true,
      "id": "share-port",
      "run": {
        "call": "ports.share"
      },
      "form": {
        "title": "Share a port",
        "fields": [
          {
            "key": "VM",
            "label": "Of",
            "kind": "select",
            "options": [
              {
                "value": "infra",
                "label": "infra"
              },
              {
                "value": "linux-3",
                "label": "linux-3"
              },
              {
                "value": "review-bot",
                "label": "review-bot"
              }
            ],
            "default": "infra",
            "required": true
          },
          {
            "key": "Port",
            "label": "Port",
            "kind": "text",
            "note": "a port number, like 5173",
            "required": true
          }
        ],
        "subtitle": "Private on your tailnet."
      },
      "sheet": "share-port"
    },
    {
      "label": "Full list in Terminal",
      "on": "page",
      "id": "full-list",
      "run": {
        "terminal": true,
        "argv": [
          "ports",
          "--on",
          "mac-mini"
        ]
      }
    },
    {
      "label": "More options for Ports",
      "on": "page",
      "id": "menu",
      "icon": "ellipsis",
      "submenu": [
        "share-port",
        "declare-public"
      ]
    }
  ],
  "header": {
    "back": "All machines",
    "glyph": {
      "kind": "symbol:network"
    },
    "buttons": [
      "menu"
    ]
  },
  "footer": {
    "kind": "terminal-list",
    "buttons": [
      "full-list",
      "share-port"
    ]
  }
}
