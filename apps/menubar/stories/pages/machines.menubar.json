            "kind": "text",
            "text": "linux-1 will stop; its disk is kept"
          },
          {
            "kind": "text",
            "text": "agent-7f will stop; its disk is kept"
          },
          {
            "kind": "text",
            "text": "Awake ends; the engine stays off until you log in again or run"
          },
          {
            "kind": "command",
            "text": "station engine start"
          }
        ],
        "danger": true,
        "yes": "Stop"
      },
      "priority": 3,
      "mutates": true,
      "id": "stop-all",
