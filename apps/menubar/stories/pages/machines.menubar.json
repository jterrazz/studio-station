      },
      "form": {
        "title": "New VM",
        "fields": [
          {
            "key": "Request.Lifetime",
            "label": "Will it last?",
            "kind": "select",
            "options": [
              {
                "value": "throwaway",
                "label": "Throwaway",
                "note": "Deleted when it powers off from inside."
              },
              {
                "value": "permanent",
                "label": "Permanent",
                "note": "Kept until you delete it."
              }
            ],
            "default": "throwaway"
          },
          {
            "key": "Request.Size.MemoryBytes",
            "label": "Memory",
            "kind": "select",
            "options": [
              {
                "value": "4294967296",
                "label": "4 GB"
              },
              {
                "value": "8589934592",
                "label": "8 GB"
              }
            ],
            "default": "4294967296"
          }
        ]
      }
    },
