{
  "schema": "station.page/v1",
  "id": "menubar.ports",
  "command": "menubar",
  "context": {
    "machine": "macbook-pro",
    "kind": "mac"
  },
  "state": "ready",
  "sections": [
    {
      "id": "summary",
      "title": "Ports",
      "role": "summary",
      "caption": [
        {
          "kind": "text",
          "text": "All machines"
        },
        {
          "kind": "text",
          "text": "0 public"
        },
        {
          "kind": "text",
          "text": "2 on your tailnet"
        }
      ]
    },
    {
      "id": "public",
      "title": "Public",
      "caption": [
        {
          "kind": "text",
          "text": "0"
        }
      ],
      "columns": [
        {
          "key": "name",
          "kind": "text",
          "keep": 100
        },
        {
          "key": "value",
          "kind": "list",
          "keep": 60
        }
      ],
      "items": [
        {
          "empty": {
            "text": "Nothing public."
          }
        }
      ],
      "glance": [
        {
          "kind": "text",
          "text": "Public"
        },
        {
          "kind": "text",
          "text": "from outside"
        }
      ]
    },
    {
      "id": "private",
      "title": "Private",
      "caption": [
        {
          "kind": "text",
          "text": "2"
        }
      ],
      "columns": [
        {
          "key": "name",
          "kind": "text",
          "keep": 100
        },
        {
          "key": "value",
          "kind": "list",
          "keep": 60
        }
      ],
      "items": [
        {
          "row": {
            "id": "linux-1:5173",
            "mark": "ok",
            "label": "Vite",
            "detail": {
              "kind": "text",
              "text": "linux-1:5173"
            },
            "glyph": {
              "kind": "port:vite"
            },
            "verb": "open-port:linux-1:5173",
            "quick": "qr:linux-1:5173",
            "menu": [
              "open-port:linux-1:5173",
              "copy-port:linux-1:5173",
              "qr:linux-1:5173",
              "-",
              "stop-sharing:linux-1:5173"
            ]
          }
        },
        {
          "row": {
            "id": "linux-1:3000",
            "mark": "ok",
            "label": "Port 3000",
            "detail": {
              "kind": "text",
              "text": "linux-1:3000"
            },
            "glyph": {
              "kind": "port:web"
            },
            "verb": "open-port:linux-1:3000",
            "quick": "qr:linux-1:3000",
            "menu": [
              "open-port:linux-1:3000",
              "copy-port:linux-1:3000",
              "qr:linux-1:3000",
              "-",
              "stop-sharing:linux-1:3000"
            ]
          }
        }
      ],
      "counts": [
        {
          "mark": "ok",
          "n": 2
        }
      ],
      "glance": [
        {
          "kind": "text",
          "text": "Private"
        },
        {
          "kind": "text",
          "text": "on your tailnet"
        }
      ],
      "about": {
        "label": "About private links",
        "text": "Private links open only on devices signed in to your tailnet; Public routes are a Cloudflare Tunnel or a Funnel you declared."
      }
    },
    {
      "id": "listening",
      "title": "Listening, not shared",
      "caption": [
        {
          "kind": "text",
          "text": "3"
        }
      ],
      "columns": [
        {
          "key": "name",
          "kind": "text",
          "keep": 100
        },
        {
          "key": "value",
          "kind": "list",
          "keep": 60
        }
      ],
      "items": [
        {
          "row": {
            "id": "linux-1:4321",
            "mark": "ok",
            "label": "Astro",
            "detail": {
              "kind": "text",
              "text": "linux-1:4321"
            },
            "glyph": {
              "kind": "port:astro"
            },
            "verb": "share:linux-1:4321"
          }
        },
        {
          "row": {
            "id": "linux-1:9229",
            "mark": "ok",
            "label": "Node inspector",
            "detail": {
              "kind": "text",
              "text": "linux-1:9229"
            },
            "glyph": {
              "kind": "port:node"
            },
            "verb": "share:linux-1:9229"
          }
        },
        {
          "row": {
            "id": "agent-7f:6006",
            "mark": "ok",
            "label": "Storybook",
            "detail": {
              "kind": "text",
              "text": "agent-7f:6006"
            },
            "glyph": {
              "kind": "port:storybook"
            },
            "verb": "share:agent-7f:6006"
          }
        }
      ],
      "counts": [
        {
          "mark": "ok",
          "n": 3
        }
      ]
    }
  ],
  "actions": [
    {
      "label": "Open Vite",
      "on": "row",
      "rows": [
        "linux-1:5173"
      ],
      "id": "open-port:linux-1:5173",
      "run": {
        "open": "https://macbook-pro.tail77a797.ts.net:40001"
      }
    },
    {
      "label": "Copy link to Vite",
      "on": "row",
      "rows": [
        "linux-1:5173"
      ],
      "id": "copy-port:linux-1:5173",
      "run": {
        "copy": "https://macbook-pro.tail77a797.ts.net:40001"
      },
      "hud": {
        "kind": "list",
        "items": [
          {
            "kind": "text",
            "text": "Copied https://macbook-pro.tail77a797.ts.net:40001"
          }
        ]
      }
    },
    {
      "label": "Show QR for Vite",
      "on": "row",
      "rows": [
        "linux-1:5173"
      ],
      "id": "qr:linux-1:5173",
      "icon": "qrcode"
    },
    {
      "label": "Stop sharing",
      "on": "row",
      "rows": [
        "linux-1:5173"
      ],
      "confirm": {
        "question": "Stop sharing linux-1:5173?",
        "lines": [
          {
            "kind": "text",
            "text": "The link stops answering on your tailnet. The service keeps running inside the VM."
          }
        ],
        "danger": true,
        "yes": "Stop sharing",
        "no": "Cancel",
        "icon": "app"
      },
      "priority": 3,
      "mutates": true,
      "id": "stop-sharing:linux-1:5173",
      "run": {
        "call": "ports.stop-sharing",
        "in": {
          "Confirm": "yes",
          "Mac": "\"macbook-pro\"",
          "Port": "\"5173\"",
          "VM": "\"linux-1\""
        }
      }
    },
    {
      "label": "Open Port 3000",
      "on": "row",
      "rows": [
        "linux-1:3000"
      ],
      "id": "open-port:linux-1:3000",
      "run": {
        "open": "https://macbook-pro.tail77a797.ts.net:40002"
      }
    },
    {
      "label": "Copy link to Port 3000",
      "on": "row",
      "rows": [
        "linux-1:3000"
      ],
      "id": "copy-port:linux-1:3000",
      "run": {
        "copy": "https://macbook-pro.tail77a797.ts.net:40002"
      },
      "hud": {
        "kind": "list",
        "items": [
          {
            "kind": "text",
            "text": "Copied https://macbook-pro.tail77a797.ts.net:40002"
          }
        ]
      }
    },
    {
      "label": "Show QR for Port 3000",
      "on": "row",
      "rows": [
        "linux-1:3000"
      ],
      "id": "qr:linux-1:3000",
      "icon": "qrcode"
    },
    {
      "label": "Stop sharing",
      "on": "row",
      "rows": [
        "linux-1:3000"
      ],
      "confirm": {
        "question": "Stop sharing linux-1:3000?",
        "lines": [
          {
            "kind": "text",
            "text": "The link stops answering on your tailnet. The service keeps running inside the VM."
          }
        ],
        "danger": true,
        "yes": "Stop sharing",
        "no": "Cancel",
        "icon": "app"
      },
      "priority": 3,
      "mutates": true,
      "id": "stop-sharing:linux-1:3000",
      "run": {
        "call": "ports.stop-sharing",
        "in": {
          "Confirm": "yes",
          "Mac": "\"macbook-pro\"",
          "Port": "\"3000\"",
          "VM": "\"linux-1\""
        }
      }
    },
    {
      "label": "Share",
      "on": "row",
      "rows": [
        "linux-1:4321"
      ],
      "mutates": true,
      "id": "share:linux-1:4321",
      "run": {
        "call": "ports.share",
        "in": {
          "Port": "4321",
          "VM": "linux-1"
        }
      },
      "hud": {
        "kind": "list",
        "items": [
          {
            "kind": "text",
            "text": "Shared Astro of linux-1"
          }
        ]
      }
    },
    {
      "label": "Share",
      "on": "row",
      "rows": [
        "linux-1:9229"
      ],
      "mutates": true,
      "id": "share:linux-1:9229",
      "run": {
        "call": "ports.share",
        "in": {
          "Port": "9229",
          "VM": "linux-1"
        }
      },
      "hud": {
        "kind": "list",
        "items": [
          {
            "kind": "text",
            "text": "Shared Node inspector of linux-1"
          }
        ]
      }
    },
    {
      "label": "Share",
      "on": "row",
      "rows": [
        "agent-7f:6006"
      ],
      "mutates": true,
      "id": "share:agent-7f:6006",
      "run": {
        "call": "ports.share",
        "in": {
          "Port": "6006",
          "VM": "agent-7f"
        }
      },
      "hud": {
        "kind": "list",
        "items": [
          {
            "kind": "text",
            "text": "Shared Storybook of agent-7f"
          }
        ]
      }
    },
    {
      "label": "Declare public",
      "on": "page",
      "priority": 2,
      "mutates": true,
      "id": "declare-public",
      "run": {
        "call": "ports.declare"
      },
      "form": {
        "title": "Declare a port public",
        "fields": [
          {
            "key": "Port",
            "label": "Port",
            "kind": "select",
            "options": [
              {
                "value": "Machine=\"linux-1\" Port=\"4321\"",
                "label": "linux-1:4321"
              },
              {
                "value": "Machine=\"linux-1\" Port=\"9229\"",
                "label": "linux-1:9229"
              },
              {
                "value": "Machine=\"agent-7f\" Port=\"6006\"",
                "label": "agent-7f:6006"
              }
            ],
            "default": "Machine=\"linux-1\" Port=\"4321\"",
            "required": true
          },
          {
            "key": "Via",
            "label": "Via",
            "kind": "select",
            "options": [
              {
                "value": "cloudflare-tunnel",
                "label": "Cloudflare Tunnel"
              },
              {
                "value": "tailscale-funnel",
                "label": "Tailscale Funnel"
              },
              {
                "value": "lan",
                "label": "your LAN"
              }
            ],
            "default": "cloudflare-tunnel",
            "required": true
          }
        ]
      }
    },
    {
      "label": "Share a port",
      "on": "page",
      "priority": 3,
      "mutates": true,
      "id": "share-port",
      "run": {
        "call": "ports.share"
      },
      "form": {
        "title": "Share a port",
        "fields": [
          {
            "key": "VM",
            "label": "Of",
            "kind": "select",
            "options": [
              {
                "value": "linux-1",
                "label": "linux-1"
              },
              {
                "value": "agent-7f",
                "label": "agent-7f"
              }
            ],
            "default": "linux-1",
            "required": true
          },
          {
            "key": "Port",
            "label": "Port",
            "kind": "text",
            "note": "a port number, like 5173",
            "required": true
          }
        ],
        "subtitle": "Private on your tailnet."
      },
      "sheet": "share-port"
    },
    {
      "label": "Full list in Terminal",
      "on": "page",
      "id": "full-list",
      "run": {
        "terminal": true,
        "argv": [
          "ports",
          "--all-machines"
        ]
      }
    },
    {
      "label": "More options for Ports",
      "on": "page",
      "id": "menu",
      "icon": "ellipsis",
      "submenu": [
        "share-port",
        "declare-public"
      ]
    }
  ],
  "header": {
    "back": "All machines",
    "glyph": {
      "kind": "symbol:network"
    },
    "buttons": [
      "menu"
    ]
  },
  "footer": {
    "kind": "terminal-list",
    "buttons": [
      "full-list",
      "share-port"
    ]
  }
}
