  "actions": [
    {
      "label": "Stop",
      "on": "page",
      "confirm": {
        "question": "Stop linux-3?",
        "lines": [
          {
            "kind": "text",
            "text": "Its disk is kept."
          }
        ],
        "yes": "Stop"
      },
      "priority": 1,
      "mutates": true,
      "id": "stop",
      "run": {
        "call": "machines.stop",
        "in": {
          "Confirm": "yes",
          "VM": "linux-3"
        },
        "target": {
          "name": "mac-mini"
        }
      }
    },
    {
      "label": "Delete",
      "on": "page",
      "confirm": {
        "question": "Delete linux-3?",
        "lines": [
          {
            "kind": "text",
            "text": "Its disk is erased: nothing of it is kept."
          },
          {
            "kind": "text",
            "text": "Type linux-3 to delete it."
          }
        ],
        "danger": true,
        "type": "linux-3",
        "yes": "Delete"
      },
      "priority": 2,
      "mutates": true,
      "id": "delete",
      "run": {
        "call": "machines.delete",
        "in": {
          "VM": "linux-3"
        },
        "target": {
          "name": "mac-mini"
        }
      }
    },
    {
      "label": "Share a port",
      "on": "page",
      "priority": 3,
      "mutates": true,
      "id": "share-port",
      "run": {
        "call": "ports.share",
        "in": {
          "VM": "linux-3"
        },
        "target": {
          "name": "mac-mini"
        }
      },
      "form": {
        "title": "Share a port of linux-3",
        "fields": [
          {
            "key": "Port",
            "label": "Port",
            "kind": "text",
            "note": "a port number, like 5173",
            "required": true
          }
        ]
      }
    },
    {
      "label": "Take back",
      "on": "row",
      "rows": [
        "github"
      ],
      "confirm": {
        "question": "Take back GitHub from linux-3?",
        "lines": [
          {
            "kind": "text",
            "text": "Its copy on linux-3 is deleted."
          }
        ],
        "yes": "Take back"
      },
      "priority": 4,
      "mutates": true,
      "id": "take-back/github",
      "run": {
        "call": "accounts.take-back",
        "in": {
          "Account": "github",
          "Confirm": "yes",
          "From": "linux-3"
        }
      }
    },
    {
      "label": "Open apps",
      "on": "row",
      "rows": [
        "apps"
      ],
      "priority": 5,
      "id": "open:apps",
      "run": {
        "terminal": true,
        "argv": [
          "apps",
          "--on",
          "linux-3"
        ]
      }
    },
    {
      "label": "Open settings",
      "on": "row",
      "rows": [
        "settings"
      ],
      "priority": 5,
      "id": "open:settings",
      "run": {
        "terminal": true,
        "argv": [
          "settings",
          "--on",
          "linux-3"
        ]
      }
    },
    {
      "label": "Open disk",
      "on": "row",
      "rows": [
        "disk"
      ],
      "priority": 5,
      "id": "open:disk",
      "run": {
        "terminal": true,
        "argv": [
          "disk",
          "--on",
          "linux-3"
        ]
      }
    },
    {
      "label": "Open Port 8080",
      "on": "row",
      "rows": [
        "linux-3:8080"
      ],
      "id": "open-port:linux-3:8080",
      "run": {
        "open": "https://mac-mini.tail77a797.ts.net:40001"
      }
    },
    {
      "label": "Copy link to Port 8080",
      "on": "row",
      "rows": [
        "linux-3:8080"
      ],
      "id": "copy-port:linux-3:8080",
      "run": {
        "copy": "https://mac-mini.tail77a797.ts.net:40001"
      },
      "hud": {
        "kind": "list",
        "items": [
          {
            "kind": "text",
            "text": "Copied https://mac-mini.tail77a797.ts.net:40001"
          }
        ]
      }
    },
    {
      "label": "Show QR for Port 8080",
      "on": "row",
      "rows": [
        "linux-3:8080"
      ],
      "id": "qr:linux-3:8080",
      "icon": "qrcode"
    },
    {
      "label": "Stop sharing",
      "on": "row",
      "rows": [
        "linux-3:8080"
      ],
      "confirm": {
        "question": "Stop sharing linux-3's port 8080?",
        "lines": [
          {
            "kind": "text",
            "text": "Its link stops working on Tailscale, and reserved port 40001 is let go."
          }
        ],
        "danger": true,
        "yes": "Stop sharing",
        "no": "Cancel"
      },
      "priority": 3,
      "mutates": true,
      "id": "stop-sharing:linux-3:8080",
      "run": {
        "call": "ports.stop-sharing",
        "in": {
          "Confirm": "yes",
          "Mac": "\"mac-mini\"",
          "Port": "\"8080\"",
          "VM": "\"linux-3\""
        }
      }
    },
    {
      "label": "Share",
      "on": "row",
      "rows": [
        "linux-3:5432"
      ],
      "mutates": true,
      "id": "share:linux-3:5432",
      "run": {
        "call": "ports.share",
        "in": {
          "Port": "5432",
          "VM": "linux-3"
        },
        "target": {
          "name": "mac-mini"
        }
      },
      "hud": {
        "kind": "list",
        "items": [
          {
            "kind": "text",
            "text": "Shared Postgres of linux-3"
          }
        ]
      }
    },
    {
      "key": "cmd+t",
      "label": "Open in Terminal",
      "on": "page",
      "priority": 2,
      "id": "open-station",
      "run": {
        "terminal": true,
        "argv": [
          "--on",
          "linux-3"
        ]
      }
    },
    {
      "label": "More options for linux-3",
      "on": "page",
      "id": "menu",
      "icon": "ellipsis",
      "submenu": [
        "stop",
        "delete",
        "open-station"
      ]
    }
