  "actions": [
    {
      "label": "Stop",
      "on": "page",
      "confirm": {
        "question": "Stop linux-3?",
        "lines": [
          {
            "kind": "text",
            "text": "Its disk is kept."
          }
        ],
        "yes": "Stop"
      },
      "priority": 1,
      "mutates": true,
      "id": "stop",
      "run": {
        "call": "machines.stop",
        "in": {
          "Confirm": "yes",
          "VM": "linux-3"
        },
        "target": {
          "name": "mac-mini"
        }
      }
    },
    {
      "label": "Delete",
      "on": "page",
      "confirm": {
        "question": "Delete linux-3?",
        "lines": [
          {
            "kind": "text",
            "text": "Its disk is erased: nothing of it is kept."
          },
          {
            "kind": "text",
            "text": "Type linux-3 to delete it."
          }
        ],
        "danger": true,
        "type": "linux-3",
        "yes": "Delete"
      },
      "priority": 2,
      "mutates": true,
      "id": "delete",
      "run": {
        "call": "machines.delete",
        "in": {
          "VM": "linux-3"
        },
        "target": {
          "name": "mac-mini"
        }
      }
    },
    {
      "label": "Share a port",
      "on": "page",
      "priority": 3,
      "mutates": true,
      "id": "share-port",
      "run": {
        "call": "ports.share",
        "in": {
          "VM": "linux-3"
        },
        "target": {
          "name": "mac-mini"
        }
      },
      "form": {
        "title": "Share a port of linux-3",
        "fields": [
          {
            "key": "Port",
            "label": "Port",
            "kind": "text",
            "note": "a port number, like 5173",
            "required": true
          }
        ]
      }
    },
    {
      "label": "Take back",
      "on": "row",
      "rows": [
        "mac-mini/linux-3/github"
      ],
      "confirm": {
        "question": "Take back GitHub from linux-3?",
        "lines": [
          {
            "kind": "text",
            "text": "Its copy on linux-3 is deleted."
          }
        ],
        "yes": "Take back"
      },
      "priority": 4,
      "mutates": true,
      "id": "take-back/github",
      "run": {
        "call": "accounts.take-back",
        "in": {
          "Account": "github",
          "Confirm": "yes",
          "From": "linux-3"
        }
      }
    },
    {
      "label": "Extend",
      "on": "row",
      "rows": [
        "mac-mini/linux-3/github"
      ],
      "mutates": true,
      "id": "extend:mac-mini/linux-3/github",
      "run": {
        "call": "accounts.share",
        "in": {
          "Account": "github",
          "For": "14400000000000",
          "With": "linux-3"
        },
        "target": {
          "name": "mac-mini"
        }
      },
      "hud": {
        "kind": "list",
        "items": [
          {
            "kind": "text",
            "text": "GitHub on linux-3"
          },
          {
            "kind": "text",
            "text": "10 hr left"
          }
        ]
      }
    },
    {
      "label": "Lend an account",
      "on": "row",
      "rows": [
        "share-account"
      ],
      "mutates": true,
      "id": "share-account",
      "run": {
        "call": "accounts.share",
        "target": {
          "name": "mac-mini"
        }
      },
      "form": {
        "title": "Lend an account",
        "fields": [
          {
            "key": "With",
            "label": "To",
            "kind": "text",
            "default": "linux-3",
            "required": true
          },
          {
            "key": "Account",
            "label": "Account",
            "kind": "text",
            "required": true
          },
          {
            "key": "For",
            "label": "For",
            "kind": "segmented",
            "options": [
              {
                "value": "14400000000000",
                "label": "4 hr"
              },
              {
                "value": "43200000000000",
                "label": "12 hr"
              },
              {
                "value": "604800000000000",
                "label": "7 days"
              }
            ],
            "default": "14400000000000"
          }
        ],
        "subtitle": "From mac-mini. It ends by itself."
      },
      "sheet": "share-account",
      "prefill": {
        "With": "linux-3"
      }
    },
    {
      "label": "Open apps",
      "on": "row",
      "rows": [
        "apps"
      ],
      "priority": 5,
      "id": "open:apps",
      "run": {
        "terminal": true,
        "argv": [
          "apps",
          "--on",
          "linux-3"
        ]
      }
    },
    {
      "label": "Open settings",
      "on": "row",
      "rows": [
        "settings"
      ],
      "priority": 5,
      "id": "open:settings",
      "run": {
        "terminal": true,
        "argv": [
          "settings",
          "--on",
          "linux-3"
        ]
      }
    },
    {
      "label": "Open disk",
      "on": "row",
      "rows": [
        "disk"
      ],
      "priority": 5,
      "id": "open:disk",
      "run": {
        "terminal": true,
        "argv": [
          "disk",
          "--on",
          "linux-3"
        ]
      }
    },
    {
      "label": "Stop sharing",
      "on": "row",
      "rows": [
        "8080"
      ],
      "confirm": {
        "question": "Stop sharing linux-3's port 8080?",
        "lines": [
          {
            "kind": "text",
            "text": "Its link stops working on Tailscale, and reserved port 40001 is let go."
          }
        ],
        "danger": true,
        "yes": "Stop sharing",
        "no": "Cancel"
      },
      "priority": 3,
      "mutates": true,
      "id": "stop-sharing:linux-3/8080",
      "run": {
        "call": "ports.stop-sharing",
        "in": {
          "Confirm": "yes",
          "Mac": "\"mac-mini\"",
          "Port": "\"8080\"",
          "VM": "\"linux-3\""
        }
      }
    },
    {
      "key": "cmd+t",
      "label": "Open in Terminal",
      "on": "page",
      "priority": 2,
      "id": "open-station",
      "run": {
        "terminal": true,
        "argv": [
          "--on",
          "linux-3"
        ]
      }
    }
  ],
  "live": [
    "cpu:linux-3",
