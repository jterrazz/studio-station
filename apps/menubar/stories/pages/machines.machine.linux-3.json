  "actions": [
    {
      "label": "Stop",
      "on": "page",
      "confirm": {
        "question": "Stop linux-3?",
        "lines": [
          {
            "kind": "text",
            "text": "Its disk is kept."
          }
        ],
        "yes": "Stop"
      },
      "priority": 1,
      "mutates": true,
      "id": "stop",
      "run": {
        "call": "machines.stop",
        "in": {
          "Confirm": "yes",
          "VM": "linux-3"
        },
        "target": {
          "name": "mac-mini"
        }
      }
    },
    {
      "label": "Delete",
      "on": "page",
      "confirm": {
        "question": "Delete linux-3?",
        "lines": [
          {
            "kind": "text",
            "text": "Its disk is erased: nothing of it is kept."
          },
          {
            "kind": "text",
            "text": "Type linux-3 to delete it."
          }
        ],
        "danger": true,
        "type": "linux-3",
        "yes": "Delete"
      },
      "priority": 2,
      "mutates": true,
      "id": "delete",
      "run": {
        "call": "machines.delete",
        "in": {
          "VM": "linux-3"
        },
        "target": {
          "name": "mac-mini"
        }
      }
    },
    {
      "key": "shift+cmd+n",
      "label": "New agent",
      "on": "page",
      "priority": 2,
      "mutates": true,
      "id": "new-agent",
      "run": {
        "call": "agents.start",
        "in": {
          "On": "linux-3"
        },
        "target": {
          "name": "mac-mini"
        }
      },
      "form": {
        "title": "New agent on linux-3",
        "fields": [
          {
            "key": "Task",
            "label": "Task",
            "kind": "text",
            "note": "empty, it waits for a prompt"
          }
        ]
      },
      "icon": "plus"
    },
    {
      "key": "cmd+enter",
      "label": "Open linux-3 in Terminal",
      "on": "row",
      "rows": [
        "linux-3"
      ],
      "priority": 2,
      "id": "attach:linux-3",
      "run": {
        "terminal": true,
        "argv": [
          "agents",
          "attach",
          "linux-3"
        ]
      },
      "icon": "terminal"
    },
    {
      "label": "Share a port",
      "on": "page",
      "priority": 3,
      "mutates": true,
      "id": "share-port",
      "run": {
        "call": "ports.share",
        "in": {
          "VM": "linux-3"
        },
        "target": {
          "name": "mac-mini"
        }
      },
      "form": {
        "title": "Share a port of linux-3",
        "fields": [
          {
            "key": "Port",
            "label": "Port",
            "kind": "text",
            "note": "a port number, like 5173",
            "required": true
          }
        ]
      }
    },
    {
      "label": "Share",
      "on": "row",
      "rows": [
        "listening"
      ],
      "priority": 3,
      "mutates": true,
      "id": "share:5432",
      "run": {
        "call": "ports.share",
        "in": {
          "Port": "5432",
          "VM": "linux-3"
        },
        "target": {
          "name": "mac-mini"
        }
      }
    },
    {
      "label": "Take back",
      "on": "row",
      "rows": [
        "github"
      ],
      "confirm": {
        "question": "Take back GitHub from linux-3?",
        "lines": [
          {
            "kind": "text",
            "text": "Its copy on linux-3 is deleted."
          }
        ],
        "yes": "Take back"
      },
      "priority": 4,
      "mutates": true,
      "id": "take-back/github",
      "run": {
        "call": "accounts.take-back",
        "in": {
          "Account": "github",
          "Confirm": "yes",
          "From": "linux-3"
        }
      }
    },
    {
      "label": "Stop sharing",
      "on": "row",
      "rows": [
        "8080"
      ],
      "confirm": {
        "question": "Stop sharing linux-3's port 8080?",
        "lines": [
          {
            "kind": "text",
            "text": "Its link stops working on Tailscale, and reserved port 40001 is let go."
          }
        ],
        "danger": true,
        "yes": "Stop sharing",
        "no": "Cancel"
      },
      "priority": 3,
      "mutates": true,
      "id": "stop-sharing:linux-3/8080",
      "run": {
        "call": "ports.stop-sharing",
        "in": {
          "Confirm": "yes",
          "Mac": "\"mac-mini\"",
          "Port": "\"8080\"",
          "VM": "\"linux-3\""
        }
      }
    },
    {
      "key": "cmd+enter",
      "label": "Open in Terminal",
      "on": "page",
      "priority": 2,
      "id": "open-station",
      "run": {
        "terminal": true,
        "argv": [
          "--on",
          "linux-3"
        ]
      }
    },
    {
      "label": "More options for linux-3",
      "on": "page",
      "id": "menu",
      "icon": "ellipsis",
      "submenu": [
        "stop",
        "delete"
      ]
    }
