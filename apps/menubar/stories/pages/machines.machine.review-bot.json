  "actions": [
    {
      "label": "Stop",
      "on": "page",
      "confirm": {
        "question": "Stop review-bot?",
        "lines": [
          {
            "kind": "text",
            "text": "Its disk is kept."
          }
        ],
        "yes": "Stop"
      },
      "priority": 1,
      "mutates": true,
      "id": "stop",
      "run": {
        "call": "machines.stop",
        "in": {
          "Confirm": "yes",
          "VM": "review-bot"
        },
        "target": {
          "name": "mac-mini"
        }
      }
    },
    {
      "label": "Delete",
      "on": "page",
      "confirm": {
        "question": "Delete review-bot?",
        "lines": [
          {
            "kind": "text",
            "text": "Its disk is erased: nothing of it is kept."
          },
          {
            "kind": "text",
            "text": "Type review-bot to delete it."
          }
        ],
        "danger": true,
        "type": "review-bot",
        "yes": "Delete"
      },
      "priority": 2,
      "mutates": true,
      "id": "delete",
      "run": {
        "call": "machines.delete",
        "in": {
          "VM": "review-bot"
        },
        "target": {
          "name": "mac-mini"
        }
      }
    },
    {
      "label": "Share a port",
      "on": "page",
      "priority": 3,
      "mutates": true,
      "id": "share-port",
      "run": {
        "call": "ports.share",
        "in": {
          "VM": "review-bot"
        },
        "target": {
          "name": "mac-mini"
        }
      },
      "form": {
        "title": "Share a port of review-bot",
        "fields": [
          {
            "key": "Port",
            "label": "Port",
            "kind": "text",
            "note": "a port number, like 5173",
            "required": true
          }
        ]
      }
    },
    {
      "label": "Take back",
      "on": "row",
      "rows": [
        "claude"
      ],
      "confirm": {
        "question": "Take back Claude from review-bot?",
        "lines": [
          {
            "kind": "text",
            "text": "Its copy on review-bot is deleted."
          }
        ],
        "yes": "Take back"
      },
      "priority": 4,
      "mutates": true,
      "id": "take-back/claude",
      "run": {
        "call": "accounts.take-back",
        "in": {
          "Account": "claude",
          "Confirm": "yes",
          "From": "review-bot"
        }
      }
    },
    {
      "label": "Open apps",
      "on": "row",
      "rows": [
        "apps"
      ],
      "priority": 5,
      "id": "open:apps",
      "run": {
        "terminal": true,
        "argv": [
          "apps",
          "--on",
          "review-bot"
        ]
      }
    },
    {
      "label": "Open settings",
      "on": "row",
      "rows": [
        "settings"
      ],
      "priority": 5,
      "id": "open:settings",
      "run": {
        "terminal": true,
        "argv": [
          "settings",
          "--on",
          "review-bot"
        ]
      }
    },
    {
      "label": "Open disk",
      "on": "row",
      "rows": [
        "disk"
      ],
      "priority": 5,
      "id": "open:disk",
      "run": {
        "terminal": true,
        "argv": [
          "disk",
          "--on",
          "review-bot"
        ]
      }
    },
    {
      "label": "Share",
      "on": "row",
      "rows": [
        "review-bot:8000"
      ],
      "mutates": true,
      "id": "share:review-bot:8000",
      "run": {
        "call": "ports.share",
        "in": {
          "Port": "8000",
          "VM": "review-bot"
        },
        "target": {
          "name": "mac-mini"
        }
      },
      "hud": {
        "kind": "list",
        "items": [
          {
            "kind": "text",
            "text": "Shared Port 8000 of review-bot"
          }
        ]
      }
    },
    {
      "key": "cmd+t",
      "label": "Open in Terminal",
      "on": "page",
      "priority": 2,
      "id": "open-station",
      "run": {
        "terminal": true,
        "argv": [
          "--on",
          "review-bot"
        ]
      }
    },
