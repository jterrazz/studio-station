  "actions": [
    {
      "label": "Stop",
      "on": "page",
      "confirm": {
        "question": "Stop review-bot?",
        "lines": [
          {
            "kind": "text",
            "text": "Its disk is kept."
          }
        ],
        "yes": "Stop"
      },
      "priority": 1,
      "mutates": true,
      "id": "stop",
      "run": {
        "call": "machines.stop",
        "in": {
          "Confirm": "yes",
          "VM": "review-bot"
        },
        "target": {
          "name": "mac-mini"
        }
      }
    },
    {
      "label": "Delete",
      "on": "page",
      "confirm": {
        "question": "Delete review-bot?",
        "lines": [
          {
            "kind": "text",
            "text": "Its disk is erased: nothing of it is kept."
          },
          {
            "kind": "text",
            "text": "Type review-bot to delete it."
          }
        ],
        "danger": true,
        "type": "review-bot",
        "yes": "Delete"
      },
      "priority": 2,
      "mutates": true,
      "id": "delete",
      "run": {
        "call": "machines.delete",
        "in": {
          "VM": "review-bot"
        },
        "target": {
          "name": "mac-mini"
        }
      }
    },
    {
      "label": "Share a port",
      "on": "page",
      "priority": 3,
      "mutates": true,
      "id": "share-port",
      "run": {
        "call": "ports.share",
        "in": {
          "VM": "review-bot"
        },
        "target": {
          "name": "mac-mini"
        }
      },
      "form": {
        "title": "Share a port of review-bot",
        "fields": [
          {
            "key": "Port",
            "label": "Port",
            "kind": "text",
            "note": "a port number, like 5173",
            "required": true
          }
        ]
      }
    },
    {
      "label": "Take back",
      "on": "row",
      "rows": [
        "mac-mini/review-bot/claude"
      ],
      "confirm": {
        "question": "Take back Claude from review-bot?",
        "lines": [
          {
            "kind": "text",
            "text": "Its copy on review-bot is deleted."
          }
        ],
        "yes": "Take back"
      },
      "priority": 4,
      "mutates": true,
      "id": "take-back/claude",
      "run": {
        "call": "accounts.take-back",
        "in": {
          "Account": "claude",
          "Confirm": "yes",
          "From": "review-bot"
        },
        "target": {
          "name": "mac-mini"
        }
      }
    },
    {
      "label": "Extend",
      "on": "row",
      "rows": [
        "mac-mini/review-bot/claude"
      ],
      "mutates": true,
      "id": "extend:mac-mini/review-bot/claude",
      "run": {
        "call": "accounts.share",
        "in": {
          "Account": "claude",
          "For": "14400000000000",
          "With": "review-bot"
        },
        "target": {
          "name": "mac-mini"
        }
      },
      "hud": {
        "kind": "list",
        "items": [
          {
            "kind": "text",
            "text": "Claude on review-bot"
          },
          {
            "kind": "text",
            "text": "4 hr left"
          }
        ]
      }
    },
    {
      "label": "Lend an account",
      "on": "row",
      "rows": [
        "share-account"
      ],
      "mutates": true,
      "id": "share-account",
      "run": {
        "call": "accounts.share",
        "target": {
          "name": "mac-mini"
        }
      },
      "form": {
        "title": "Lend an account",
        "fields": [
          {
            "key": "With",
            "label": "To",
            "kind": "text",
            "default": "review-bot",
            "required": true
          },
          {
            "key": "Account",
            "label": "Account",
            "kind": "text",
            "required": true
          },
          {
            "key": "For",
            "label": "For",
            "kind": "segmented",
            "options": [
              {
                "value": "14400000000000",
                "label": "4 hr"
              },
              {
                "value": "43200000000000",
                "label": "12 hr"
              },
              {
                "value": "604800000000000",
                "label": "7 days"
              }
            ],
            "default": "14400000000000"
          }
        ],
        "subtitle": "From mac-mini. It ends by itself."
      },
      "sheet": "share-account",
      "prefill": {
        "With": "review-bot"
      }
    },
    {
      "label": "Open apps",
      "on": "row",
      "rows": [
        "apps"
      ],
      "priority": 5,
      "id": "open:apps",
      "run": {
        "terminal": true,
        "argv": [
          "apps",
          "--on",
          "review-bot"
        ]
      }
    },
    {
      "label": "Open settings",
