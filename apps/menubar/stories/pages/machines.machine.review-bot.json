      "id": "open:settings",
      "run": {
        "terminal": true,
        "argv": [
          "settings",
          "--on",
          "review-bot"
        ]
      }
    },
    {
      "label": "Open disk",
      "on": "row",
      "rows": [
        "disk"
      ],
      "priority": 5,
      "id": "open:disk",
      "run": {
        "terminal": true,
        "argv": [
          "disk",
          "--on",
          "review-bot"
        ]
      }
    },
    {
      "key": "cmd+t",
