  "actions": [
    {
      "label": "Stop",
      "on": "page",
      "confirm": {
        "question": "Stop review-bot?",
        "lines": [
          {
            "kind": "text",
            "text": "Its disk is kept."
          }
        ],
        "yes": "Stop"
      },
      "priority": 1,
      "mutates": true,
      "id": "stop",
      "run": {
        "call": "machines.stop",
        "in": {
          "Confirm": "yes",
          "VM": "review-bot"
        },
        "target": {
          "name": "mac-mini"
        }
      }
    },
    {
      "label": "Delete",
      "on": "page",
      "confirm": {
        "question": "Delete review-bot?",
        "lines": [
          {
            "kind": "text",
            "text": "Its disk is erased: nothing of it is kept."
          },
          {
            "kind": "text",
            "text": "Type review-bot to delete it."
          }
        ],
        "danger": true,
        "type": "review-bot",
        "yes": "Delete"
      },
      "priority": 2,
      "mutates": true,
      "id": "delete",
      "run": {
        "call": "machines.delete",
        "in": {
          "VM": "review-bot"
        },
        "target": {
          "name": "mac-mini"
        }
      }
    },
    {
      "key": "shift+cmd+n",
      "label": "New agent",
      "on": "page",
      "priority": 2,
      "mutates": true,
      "id": "new-agent",
      "run": {
        "call": "agents.start",
        "in": {
          "On": "review-bot"
        },
        "target": {
          "name": "mac-mini"
        }
      },
      "form": {
        "title": "New agent on review-bot",
        "fields": [
          {
            "key": "Task",
            "label": "Task",
            "kind": "text",
            "note": "empty, it waits for a prompt"
          }
        ]
      },
      "icon": "plus"
    },
    {
      "key": "cmd+enter",
      "label": "Open review-bot in Terminal",
      "on": "row",
      "rows": [
        "review-bot"
      ],
      "priority": 2,
      "id": "attach:review-bot",
      "run": {
        "terminal": true,
        "argv": [
          "agents",
          "attach",
          "review-bot"
        ]
      },
      "icon": "terminal"
    },
    {
      "label": "Share a port",
      "on": "page",
      "priority": 3,
      "mutates": true,
      "id": "share-port",
      "run": {
        "call": "ports.share",
        "in": {
          "VM": "review-bot"
        },
        "target": {
          "name": "mac-mini"
        }
      },
      "form": {
        "title": "Share a port of review-bot",
        "fields": [
          {
            "key": "Port",
            "label": "Port",
            "kind": "text",
            "note": "a port number, like 5173",
            "required": true
          }
        ]
      }
    },
    {
      "label": "Share",
      "on": "row",
      "rows": [
        "listening"
      ],
      "priority": 3,
      "mutates": true,
      "id": "share:8000",
      "run": {
        "call": "ports.share",
        "in": {
          "Port": "8000",
          "VM": "review-bot"
        },
        "target": {
          "name": "mac-mini"
        }
      }
    },
    {
      "label": "Take back",
      "on": "row",
      "rows": [
        "claude"
      ],
      "confirm": {
        "question": "Take back Claude from review-bot?",
        "lines": [
          {
            "kind": "text",
            "text": "Its copy on review-bot is deleted."
          }
        ],
        "yes": "Take back"
      },
      "priority": 4,
      "mutates": true,
      "id": "take-back/claude",
      "run": {
        "call": "accounts.take-back",
        "in": {
          "Account": "claude",
          "Confirm": "yes",
          "From": "review-bot"
        }
      }
    },
    {
      "key": "cmd+enter",
      "label": "Open in Terminal",
      "on": "page",
      "priority": 2,
      "id": "open-station",
      "run": {
        "terminal": true,
        "argv": [
          "--on",
          "review-bot"
        ]
      }
    },
    {
      "label": "More options for review-bot",
      "on": "page",
      "id": "menu",
      "icon": "ellipsis",
      "submenu": [
        "stop",
        "delete"
      ]
    }
