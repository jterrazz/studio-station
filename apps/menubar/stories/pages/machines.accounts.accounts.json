      "on": "row",
      "rows": [
        "mac-mini/review-bot/claude"
      ],
      "mutates": true,
      "id": "extend:mac-mini/review-bot/claude",
      "run": {
        "call": "accounts.share",
        "in": {
          "Account": "claude",
          "For": "14400000000000",
          "With": "review-bot"
        },
        "target": {
          "name": "mac-mini"
        }
      },
      "hud": {
        "kind": "list",
        "items": [
          {
            "kind": "text",
            "text": "Claude on review-bot"
          },
          {
            "kind": "text",
            "text": "13 hr left"
          }
        ]
      }
    },
    {
      "label": "Full list in Terminal",
      "on": "page",
      "priority": 2,
      "id": "full-list",
      "run": {
        "terminal": true,
        "argv": [
          "accounts",
          "--all-machines"
        ]
      },
      "icon": "arrow.up.forward"
    },
    {
      "label": "Lend an account",
      "on": "page",
      "mutates": true,
      "id": "share-account",
      "run": {
        "call": "accounts.share"
      },
      "form": {
        "title": "Lend an account",
        "fields": [
          {
            "key": "With",
            "label": "To",
            "kind": "text",
            "required": true
          },
          {
            "key": "Account",
            "label": "Account",
            "kind": "text",
            "required": true
          },
          {
            "key": "For",
            "label": "For",
            "kind": "segmented",
            "options": [
              {
                "value": "14400000000000",
                "label": "4 hr"
              },
              {
                "value": "43200000000000",
                "label": "12 hr"
              },
              {
                "value": "604800000000000",
                "label": "7 days"
              }
            ],
            "default": "14400000000000"
          }
        ],
        "subtitle": "From This Mac. It ends by itself."
      },
      "icon": "plus",
      "sheet": "share-account"
    }
  ],
  "header": {
    "back": "All machines",
    "glyph": {
      "kind": "symbol:key"
    }
  },
  "footer": {
    "kind": "terminal-list",
    "buttons": [
      "full-list",
      "share-account"
    ]
  }
