        "call": "accounts.share",
        "in": {
          "Account": "claude",
          "For": "14400000000000",
          "With": "linux-1"
        }
      },
      "hud": {
        "kind": "list",
        "items": [
          {
            "kind": "text",
            "text": "Claude on linux-1"
          },
          {
            "kind": "text",
            "text": "4 hr 24 min left"
          }
        ]
      }
    },
    {
      "label": "Extend",
      "on": "row",
      "rows": [
        "macbook-pro/linux-1/github"
      ],
      "mutates": true,
      "id": "extend:macbook-pro/linux-1/github",
