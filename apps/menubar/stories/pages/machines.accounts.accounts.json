      "on": "row",
      "rows": [
        "mac-mini/linux-3/github"
      ],
      "mutates": true,
      "id": "extend:mac-mini/linux-3/github",
      "run": {
        "call": "accounts.share",
        "in": {
          "Account": "github",
          "For": "14400000000000",
          "With": "linux-3"
        },
        "target": {
          "name": "mac-mini"
        }
      },
      "hud": {
        "kind": "list",
        "items": [
          {
            "kind": "text",
            "text": "GitHub on linux-3"
          },
          {
            "kind": "text",
            "text": "10 hr left"
          }
        ]
      }
    },
    {
