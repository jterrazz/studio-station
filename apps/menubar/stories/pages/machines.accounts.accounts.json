      "label": "Extend",
      "on": "row",
      "rows": [
        "short/macbook-pro/linux-1/claude"
      ],
      "mutates": true,
      "id": "ending:macbook-pro/linux-1/claude",
      "run": {
        "call": "accounts.share",
        "in": {
          "Account": "claude",
          "For": "14400000000000",
          "With": "linux-1"
        }
      },
      "default": true,
      "hud": {
        "kind": "list",
        "items": [
          {
            "kind": "text",
            "text": "Claude on linux-1"
          },
          {
            "kind": "text",
            "text": "4 hr 24 min left"
          }
        ]
      }
    },
    {
      "label": "Sign in",
      "on": "row",
      "rows": [
        "macbook-pro/npm"
      ],
      "id": "sign-in:macbook-pro/npm",
      "run": {
        "terminal": true,
        "argv": [
          "accounts"
        ]
      },
      "default": true,
      "busy": "Waiting",
      "hud": {
        "kind": "list",
        "items": [
          {
            "kind": "text",
            "text": "Terminal"
          },
          {
            "kind": "text",
            "text": "npm login on This Mac"
          }
        ]
      }
    },
    {
      "label": "Extend",
      "on": "row",
      "rows": [
        "macbook-pro/linux-1/claude"
      ],
      "mutates": true,
      "id": "extend:macbook-pro/linux-1/claude",
