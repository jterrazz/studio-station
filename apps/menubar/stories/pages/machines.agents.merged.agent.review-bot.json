              "kind": "list",
              "items": [
                {
                  "kind": "text",
                  "text": "mac-mini"
                },
                {
                  "kind": "text",
                  "text": "permanent"
                },
                {
                  "kind": "text",
                  "text": "idle 1 min"
                }
              ]
            },
            "glyph": {
              "kind": "agent",
              "signal": "active"
            },
            "nav": "menubar.machine:review-bot"
          }
        }
      ],
      "uncounted": true,
      "card": "flush"
