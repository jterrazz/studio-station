      "label": "Keep mac-mini awake",
      "on": "row",
      "rows": [
        "awake"
      ],
      "confirm": {
        "question": "Let mac-mini sleep again?",
        "lines": [
          {
            "kind": "text",
            "text": "It hosts infra (server): infra pauses while mac-mini sleeps."
          }
        ],
        "danger": true,
        "yes": "Allow sleep",
        "no": "Keep it awake"
      },
      "priority": 2,
      "mutates": true,
      "id": "change:mac-mini",
      "run": {
        "call": "settings.off",
        "in": {
          "Confirm": "yes",
          "Names": "[\"never-sleeps\"]"
        },
        "target": {
          "name": "mac-mini"
        }
      }
    },
