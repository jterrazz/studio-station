{
  "schema": "station.page/v1",
  "id": "menubar.machine",
  "command": "menubar",
  "context": {
    "machine": "macbook-air",
    "kind": "mac"
  },
  "state": "loading",
  "sections": [
    {
      "id": "summary",
      "title": "macbook-air",
      "role": "summary"
    },
    {
      "id": "gauges",
      "title": "Gauges",
      "items": [
        {
          "gauge": {
            "title": "CPU",
            "value": {
              "kind": "pending",
              "live": "cpu:macbook-air"
            },
            "stale": true
          }
        },
        {
          "gauge": {
            "title": "Memory",
            "value": {
              "kind": "pending",
              "live": "free:macbook-air"
            },
            "stale": true
          }
        },
        {
          "gauge": {
            "title": "Network",
            "value": {
              "kind": "pending",
              "live": "net:macbook-air"
            },
            "stale": true
          }
        }
      ],
      "segment": "overview",
      "card": "gauges"
    },
    {
      "id": "vms",
      "title": "VMs",
      "columns": [
        {
          "key": "name",
          "kind": "text",
          "keep": 100
        },
        {
          "key": "cpu",
          "kind": "percent",
          "keep": 20
        }
      ],
      "items": [
        {
          "empty": {
            "text": "No VMs on macbook-air yet",
            "actions": [
              "new-vm"
            ]
          }
        }
      ],
      "uncounted": true,
      "segment": "overview",
      "card": "empty"
    },
    {
      "id": "care",
      "title": "Care",
      "columns": [
        {
          "key": "name",
          "kind": "text",
          "keep": 100
        },
        {
          "key": "value",
          "kind": "list",
          "keep": 60
        }
      ],
      "items": [
        {
          "row": {
            "id": "awake",
            "mark": "ok",
            "label": "Sleeps as usual",
            "cells": [
              {
                "kind": "off"
              }
            ],
            "detail": {
              "kind": "text",
              "text": "nothing pauses if it sleeps"
            },
            "glyph": {
              "kind": "symbol:moon",
              "signal": "quiet"
            },
            "verb": "change:macbook-air"
          }
        },
        {
          "group": {
            "head": {
              "id": "upkeep",
              "mark": "ok",
              "label": "Upkeep",
              "cells": [
                {
                  "kind": "text",
                  "text": "checking"
                }
              ],
              "glyph": {
                "kind": "symbol:wrench.adjustable",
                "signal": "quiet"
              },
              "trail": "value"
            },
            "fold": "folded"
          }
        }
      ],
      "uncounted": true,
      "segment": "overview",
      "card": "care"
    },
    {
      "id": "activity",
      "title": "Activity",
      "role": "summary",
      "columns": [
        {
          "key": "name",
          "kind": "text",
          "keep": 100
        },
        {
          "key": "value",
          "kind": "list",
          "keep": 60
        },
        {
          "key": "graph",
          "kind": "spark",
          "keep": 50
        }
      ],
      "items": [
        {
          "row": {
            "id": "cpu",
            "label": "CPU",
            "cells": [
              {
                "kind": "pending",
                "live": "cpu:macbook-air"
              }
            ]
          }
        },
        {
          "row": {
            "id": "memory",
            "label": "Memory",
            "cells": [
              {
                "kind": "pending",
                "live": "memory:macbook-air"
              }
            ]
          }
        },
        {
          "row": {
            "id": "disk",
            "label": "Disk",
            "cells": [
              {
                "kind": "pending",
                "live": "disk:macbook-air"
              }
            ]
          }
        }
      ],
      "segment": "activity"
    },
    {
      "id": "public",
      "title": "Public",
      "caption": [
        {
          "kind": "text",
          "text": "0"
        }
      ],
      "columns": [
        {
          "key": "name",
          "kind": "text",
          "keep": 100
        },
        {
          "key": "value",
          "kind": "list",
          "keep": 60
        }
      ],
      "items": [
        {
          "empty": {
            "text": "Nothing public."
          }
        }
      ],
      "glance": [
        {
          "kind": "text",
          "text": "Public"
        },
        {
          "kind": "text",
          "text": "from outside"
        }
      ],
      "segment": "ports"
    },
    {
      "id": "private",
      "title": "Private",
      "caption": [
        {
          "kind": "text",
          "text": "0"
        }
      ],
      "columns": [
        {
          "key": "name",
          "kind": "text",
          "keep": 100
        },
        {
          "key": "value",
          "kind": "list",
          "keep": 60
        }
      ],
      "items": [
        {
          "empty": {
            "text": "Nothing shared yet"
          }
        }
      ],
      "glance": [
        {
          "kind": "text",
          "text": "Private"
        },
        {
          "kind": "text",
          "text": "on your tailnet"
        }
      ],
      "segment": "ports",
      "about": {
        "label": "About private links",
        "text": "Private links open only on devices signed in to your tailnet; Public routes are a Cloudflare Tunnel or a Funnel you declared."
      }
    },
    {
      "id": "https",
      "title": "HTTPS links",
      "columns": [
        {
          "key": "name",
          "kind": "text",
          "keep": 100
        },
        {
          "key": "value",
          "kind": "list",
          "keep": 60
        }
      ],
      "items": [
        {
          "row": {
            "id": "https",
            "mark": "ok",
            "label": "HTTPS links on macbook-air",
            "cells": [
              {
                "kind": "on"
              }
            ],
            "glyph": {
              "kind": "symbol:lock"
            },
            "verb": "https:macbook-air"
          }
        }
      ],
      "counts": [
        {
          "mark": "ok",
          "n": 1
        }
      ],
      "segment": "ports",
      "card": "flush"
    },
    {
      "id": "accounts",
      "title": "Accounts",
      "columns": [
        {
          "key": "name",
          "kind": "text",
          "keep": 100
        },
        {
          "key": "value",
          "kind": "list",
          "keep": 60
        }
      ],
      "items": [
        {
          "empty": {
            "text": "No account shared"
          }
        }
      ],
      "segment": "accounts"
    }
  ],
  "actions": [
    {
      "key": "cmd+n",
      "label": "New VM",
      "on": "page",
      "priority": 1,
      "mutates": true,
      "id": "new-vm",
      "run": {
        "call": "machines.create-workspace",
        "in": {
          "Request.Image": "linux",
          "Request.Network": "nat"
        },
        "target": {
          "name": "macbook-air"
        }
      },
      "form": {
        "title": "New VM",
        "fields": [
          {
            "key": "Request.Lifetime",
            "label": "Will it last?",
            "kind": "select",
            "options": [
              {
                "value": "throwaway",
                "label": "Throwaway",
                "note": "Deleted when it powers off from inside."
              },
              {
                "value": "permanent",
                "label": "Permanent",
                "note": "Kept until you delete it."
              }
            ],
            "default": "throwaway"
          },
          {
            "key": "Request.Size.MemoryBytes",
            "label": "Memory",
            "kind": "select",
            "options": [
              {
                "value": "4294967296",
                "label": "4 GB"
              },
              {
                "value": "8589934592",
                "label": "8 GB"
              }
            ],
            "default": "4294967296"
          }
        ]
      },
      "icon": "plus"
    },
    {
      "label": "Keep macbook-air awake",
      "on": "row",
      "rows": [
        "awake"
      ],
      "confirm": {
        "question": "Keep macbook-air awake for good?",
        "lines": [
          {
            "kind": "text",
            "text": "Never sleeps: the always-on Mac policy, until you change it again."
          }
        ],
        "yes": "Never sleep",
        "no": "Cancel"
      },
      "priority": 2,
      "mutates": true,
      "id": "change:macbook-air",
      "run": {
        "call": "settings.apply",
        "in": {
          "Confirm": "yes",
          "Names": "[\"never-sleeps\"]"
        },
        "target": {
          "name": "macbook-air"
        }
      }
    },
    {
      "label": "HTTPS links on macbook-air",
      "on": "row",
      "rows": [
        "https"
      ],
      "mutates": true,
      "id": "https:macbook-air",
      "run": {
        "call": "ports.set-https",
        "in": {
          "On": "false"
        },
        "target": {
          "name": "macbook-air"
        }
      }
    },
    {
      "key": "cmd+t",
      "label": "Open in Terminal",
      "on": "page",
      "priority": 2,
      "id": "open-station",
      "run": {
        "terminal": true,
        "argv": [
          "--on",
          "macbook-air"
        ]
      }
    },
    {
      "label": "More options for macbook-air",
      "on": "page",
      "id": "menu",
      "icon": "ellipsis",
      "submenu": [
        "open-station"
      ]
    }
  ],
  "header": {
    "back": "All machines",
    "glyph": {
      "kind": "desktop"
    },
    "buttons": [
      "menu"
    ],
    "stale": {
      "kind": "list",
      "items": [
        {
          "kind": "text",
          "text": "seen 2 hr ago"
        },
        {
          "kind": "text",
          "text": "checking"
        }
      ]
    }
  },
  "segments": [
    {
      "id": "overview",
      "label": "Overview",
      "picked": true
    },
    {
      "id": "activity",
      "label": "Activity",
      "key": "cmd+i"
    },
    {
      "id": "ports",
      "label": "Ports",
      "key": "cmd+p"
    },
    {
      "id": "accounts",
      "label": "Accounts",
      "key": "cmd+u"
    }
  ],
  "live": [
    "cpu:macbook-air",
    "memory:macbook-air",
    "disk:macbook-air",
    "free:macbook-air",
    "net:macbook-air"
  ]
}
