          "picked": true
        },
        {
          "label": "24 hr",
          "on": "page",
          "id": "window-24h"
        }
      ]
    },
    {
      "id": "memory",
      "title": "Memory",
      "role": "summary",
      "caption": [
        {
          "kind": "text",
          "text": "now"
        }
      ],
      "columns": [
        {
          "key": "name",
          "kind": "text",
          "keep": 100
        },
        {
          "key": "value",
          "kind": "list",
          "keep": 60
        }
      ],
      "items": [
        {
          "gauge": {
            "title": "Memory",
            "value": {
              "kind": "pending",
              "live": "free:macbook-air"
            }
          }
        }
      ],
      "uncounted": true,
      "segment": "activity",
      "card": "chart"
    },
    {
      "id": "processes",
      "title": "Top processes",
      "role": "summary",
      "caption": [
        {
          "kind": "text",
          "text": "CPU, of macbook-air"
        }
      ],
      "columns": [
        {
          "key": "name",
          "kind": "text",
          "keep": 100
        },
        {
          "key": "cpu",
          "kind": "percent",
          "keep": 20
        }
      ],
      "uncounted": true,
      "segment": "activity"
    },
    {
      "id": "public",
      "title": "Public",
      "caption": [
        {
          "kind": "text",
          "text": "0"
        }
      ],
      "columns": [
        {
          "key": "name",
          "kind": "text",
          "keep": 100
        },
        {
          "key": "value",
          "kind": "list",
          "keep": 60
        }
      ],
      "items": [
        {
          "empty": {
            "text": "Nothing public."
          }
        }
      ],
      "glance": [
        {
          "kind": "text",
          "text": "Public"
        },
        {
          "kind": "text",
          "text": "from outside"
        }
      ],
      "segment": "ports"
    },
    {
      "id": "private",
      "title": "Private",
      "caption": [
        {
          "kind": "text",
          "text": "0"
        }
      ],
      "columns": [
        {
          "key": "name",
          "kind": "text",
          "keep": 100
        },
        {
          "key": "value",
          "kind": "list",
          "keep": 60
        }
      ],
      "items": [
        {
          "empty": {
            "text": "Nothing shared yet"
          }
        }
      ],
      "glance": [
        {
          "kind": "text",
          "text": "Private"
        },
        {
          "kind": "text",
          "text": "on your tailnet"
        }
      ],
      "segment": "ports",
      "about": {
        "label": "About private links",
        "text": "Private links open only on devices signed in to your tailnet; Public routes are a Cloudflare Tunnel or a Funnel you declared."
      }
    },
    {
      "id": "https",
      "title": "HTTPS links",
      "columns": [
        {
          "key": "name",
          "kind": "text",
          "keep": 100
        },
        {
          "key": "value",
          "kind": "list",
          "keep": 60
        }
      ],
      "items": [
        {
          "row": {
            "id": "https",
            "mark": "ok",
            "label": "HTTPS links on macbook-air",
            "cells": [
              {
                "kind": "on"
              }
            ],
            "glyph": {
              "kind": "symbol:lock"
            },
            "verb": "https:macbook-air"
          }
        }
      ],
      "counts": [
        {
          "mark": "ok",
          "n": 1
        }
      ],
      "segment": "ports",
      "card": "flush"
    },
    {
      "id": "accounts:shared",
      "title": "Lent to VMs",
      "caption": [
        {
          "kind": "text",
          "text": "0"
        }
      ],
      "columns": [
        {
          "key": "name",
          "kind": "text",
          "keep": 100
        },
        {
          "key": "value",
          "kind": "list",
          "keep": 60
        }
      ],
      "items": [
        {
          "row": {
            "id": "share-account",
            "mark": "ok",
            "label": "Lend an account",
            "cells": [
              {
                "kind": "text",
                "text": "ends by itself"
              }
            ],
            "glyph": {
              "kind": "symbol:plus",
              "signal": "active"
            },
            "trail": "value",
            "verb": "share-account"
          }
        }
      ],
      "counts": [
        {
          "mark": "ok",
          "n": 1
        }
      ],
      "segment": "accounts",
      "card": "flush"
    }
  ],
  "actions": [
    {
      "key": "cmd+n",
      "label": "New VM",
      "on": "page",
      "priority": 1,
      "mutates": true,
      "id": "new-vm",
      "run": {
        "call": "machines.create-workspace",
        "in": {
          "Request.Image": "linux",
          "Request.Network": "nat"
        },
        "target": {
          "name": "macbook-air"
        }
      },
      "form": {
        "title": "New VM",
        "fields": [
          {
            "key": "Request.Lifetime",
            "label": "Will it last?",
            "kind": "select",
            "options": [
              {
                "value": "throwaway",
                "label": "Throwaway",
                "note": "Deleted when it powers off from inside."
              },
              {
                "value": "permanent",
                "label": "Permanent",
                "note": "Kept until you delete it."
              }
            ],
            "default": "throwaway"
          },
          {
            "key": "Request.Size.MemoryBytes",
            "label": "Memory",
            "kind": "select",
            "options": [
              {
                "value": "4294967296",
                "label": "4 GB"
              },
              {
                "value": "8589934592",
                "label": "8 GB"
              }
            ],
            "default": "4294967296"
          }
        ]
      },
      "icon": "plus"
    },
    {
      "label": "Keep macbook-air awake",
      "on": "row",
      "rows": [
        "awake"
      ],
      "confirm": {
        "question": "Keep macbook-air awake for good?",
        "lines": [
          {
            "kind": "text",
            "text": "Never sleeps: the always-on Mac policy, until you change it again."
          }
        ],
        "yes": "Never sleep",
        "no": "Cancel"
      },
      "priority": 2,
      "mutates": true,
      "id": "change:macbook-air",
      "run": {
        "call": "settings.apply",
        "in": {
          "Confirm": "yes",
          "Names": "[\"never-sleeps\"]"
        },
        "target": {
          "name": "macbook-air"
        }
      }
    },
    {
      "label": "HTTPS links on macbook-air",
      "on": "row",
      "rows": [
        "https"
      ],
      "mutates": true,
      "id": "https:macbook-air",
      "run": {
        "call": "ports.set-https",
        "in": {
          "On": "false"
        },
        "target": {
          "name": "macbook-air"
        }
      }
    },
    {
      "label": "Lend an account",
      "on": "row",
      "rows": [
        "share-account"
      ],
      "mutates": true,
      "id": "share-account",
      "run": {
        "call": "accounts.share",
        "target": {
          "name": "macbook-air"
        }
      },
      "form": {
        "title": "Lend an account",
        "fields": [
          {
            "key": "With",
            "label": "To",
            "kind": "text",
            "required": true
          },
          {
            "key": "Account",
            "label": "Account",
            "kind": "text",
            "required": true
          },
          {
            "key": "For",
            "label": "For",
            "kind": "segmented",
            "options": [
              {
                "value": "14400000000000",
                "label": "4 hr"
              },
              {
                "value": "43200000000000",
                "label": "12 hr"
              },
              {
                "value": "604800000000000",
                "label": "7 days"
              }
            ],
            "default": "14400000000000"
          }
        ],
        "subtitle": "From air. It ends by itself."
      },
      "sheet": "share-account"
    },
    {
      "key": "cmd+t",
      "label": "Open in Terminal",
      "on": "page",
      "priority": 2,
      "id": "open-station",
      "run": {
        "terminal": true,
        "argv": [
          "--on",
          "macbook-air"
        ]
      }
    },
    {
      "label": "Restart macbook-air",
      "on": "page",
      "confirm": {
        "question": "Restart macbook-air?",
        "lines": [
          {
            "kind": "text",
            "text": "Its VMs pause while it restarts, about 2 min."
          }
        ],
        "danger": true,
        "yes": "Restart macbook-air",
        "no": "Cancel",
        "icon": "app"
      },
      "priority": 3,
      "mutates": true,
      "id": "restart-mac",
      "run": {
        "call": "machines.restart-mac",
        "in": {
          "Confirm": "yes",
          "Name": "\"macbook-air\""
        }
      },
      "hud": {
        "kind": "list",
        "items": [
          {
            "kind": "text",
            "text": "macbook-air restarts…"
          }
        ]
      }
    },
    {
      "label": "Forget macbook-air",
      "on": "page",
      "confirm": {
        "question": "Forget macbook-air?",
        "lines": [
          {
            "kind": "text",
            "text": "Its VMs keep running; station stops showing it. You can add it again."
          }
        ],
        "danger": true,
        "yes": "Forget macbook-air",
        "no": "Cancel",
        "icon": "app"
      },
      "priority": 4,
      "mutates": true,
      "id": "forget-mac",
      "run": {
        "call": "machines.forget",
        "in": {
          "Confirm": "yes",
          "Name": "\"macbook-air\""
        }
      }
    },
    {
      "label": "More options for macbook-air",
      "on": "page",
      "id": "menu",
      "icon": "ellipsis",
      "submenu": [
        "open-station",
        "restart-mac",
        "forget-mac"
      ]
    }
  ],
  "header": {
    "back": "All machines",
    "glyph": {
      "kind": "desktop"
    },
    "buttons": [
      "menu"
    ],
    "stale": {
      "kind": "list",
      "items": [
        {
          "kind": "text",
          "text": "seen 2 hr ago"
        },
        {
          "kind": "text",
          "text": "checking"
        }
      ]
    }
  },
  "segments": [
    {
      "id": "overview",
      "label": "Overview",
      "picked": true
    },
    {
      "id": "activity",
      "label": "Activity",
      "key": "cmd+i"
    },
    {
      "id": "ports",
      "label": "Ports",
      "key": "cmd+p"
    },
    {
      "id": "accounts",
      "label": "Accounts",
      "key": "cmd+u"
    }
  ],
  "live": [
    "cpu:macbook-air",
    "free:macbook-air",
    "net:macbook-air"
  ]
}
