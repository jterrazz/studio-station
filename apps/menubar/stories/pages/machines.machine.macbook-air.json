{
  "schema": "station.page/v1",
  "id": "menubar.machine",
  "command": "menubar",
  "context": {
    "machine": "macbook-air",
    "kind": "mac"
  },
  "state": "loading",
  "sections": [
    {
      "id": "summary",
      "title": "macbook-air",
      "role": "summary"
    },
    {
      "id": "gauges",
      "title": "Gauges",
      "items": [
        {
          "gauge": {
            "title": "CPU",
            "value": {
              "kind": "pending",
              "live": "cpu:macbook-air"
            },
            "stale": true
          }
        },
        {
          "gauge": {
            "title": "Memory",
            "value": {
              "kind": "pending",
              "live": "free:macbook-air"
            },
            "stale": true
          }
        },
        {
          "gauge": {
            "title": "Network",
            "value": {
              "kind": "pending",
              "live": "net:macbook-air"
            },
            "stale": true
          }
        }
      ],
      "segment": "overview",
      "card": "gauges"
    },
    {
      "id": "vms",
      "title": "VMs",
      "columns": [
        {
          "key": "name",
          "kind": "text",
          "keep": 100
        },
        {
          "key": "cpu",
          "kind": "percent",
          "keep": 20
        }
      ],
      "items": [
        {
          "empty": {
            "text": "No VMs on macbook-air yet",
            "actions": [
              "new-vm"
            ]
          }
        }
      ],
      "uncounted": true,
      "segment": "overview",
      "card": "empty"
    },
    {
      "id": "care",
      "title": "Care",
      "columns": [
        {
          "key": "name",
          "kind": "text",
          "keep": 100
        },
        {
          "key": "value",
          "kind": "list",
          "keep": 60
        }
      ],
      "items": [
        {
          "row": {
            "id": "awake",
            "mark": "ok",
            "label": "Sleeps as usual",
            "cells": [
              {
                "kind": "off"
              }
            ],
            "detail": {
              "kind": "text",
              "text": "nothing pauses if it sleeps"
            },
            "glyph": {
              "kind": "symbol:moon",
              "signal": "quiet"
            },
            "verb": "change:macbook-air"
          }
        },
        {
          "group": {
            "head": {
              "id": "upkeep",
              "mark": "ok",
              "label": "Upkeep",
              "cells": [
                {
                  "kind": "text",
                  "text": "checking"
                }
              ],
              "glyph": {
                "kind": "symbol:wrench.adjustable",
                "signal": "quiet"
              },
              "trail": "value"
            },
            "fold": "folded"
          }
        }
      ],
      "uncounted": true,
      "segment": "overview",
      "card": "care"
    },
    {
      "id": "window-6m",
      "title": "Last 6 minutes",
      "role": "summary",
      "columns": [
        {
          "key": "name",
          "kind": "text",
          "keep": 100
        },
        {
          "key": "value",
          "kind": "list",
          "keep": 60
        }
      ],
      "items": [
        {
          "row": {
            "id": "cpu",
            "label": "CPU",
            "cells": [
              {
                "kind": "pending",
                "live": "cpu:macbook-air"
              }
            ],
            "detail": {
              "kind": "text",
              "text": "now"
            }
          }
        },
        {
          "row": {
            "id": "network",
            "label": "Network",
            "cells": [
              {
                "kind": "pending"
              }
            ]
          }
        }
      ],
      "uncounted": true,
      "segment": "activity",
      "card": "chart",
      "picker": [
        {
          "label": "6 min",
