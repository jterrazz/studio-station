        }
      ]
    },
    {
      "id": "window-24h",
      "title": "Last 24 hours",
      "role": "summary",
      "columns": [
        {
          "key": "name",
          "kind": "text",
          "keep": 100
        },
        {
          "key": "value",
          "kind": "list",
          "keep": 60
        }
      ],
      "items": [
        {
          "row": {
            "id": "cpu",
            "label": "CPU",
            "cells": [
              {
                "kind": "pending",
                "live": "cpu:macbook-air"
              }
            ],
            "detail": {
              "kind": "text",
              "text": "now"
            }
          }
        },
        {
          "row": {
            "id": "network",
            "label": "Network",
            "cells": [
              {
                "kind": "pending"
              }
            ]
          }
        }
      ],
      "uncounted": true,
      "segment": "activity",
      "card": "chart",
      "picker": [
        {
          "label": "6 min",
          "on": "page",
          "id": "window-6m"
        },
        {
          "label": "1 hr",
          "on": "page",
