  "actions": [
    {
      "label": "Restart",
      "on": "page",
      "priority": 1,
      "mutates": true,
      "id": "restart",
      "run": {
        "call": "machines.restart",
        "in": {
          "Name": "infra"
        },
        "target": {
          "name": "mac-mini"
        }
      }
    },
    {
      "label": "Stop",
      "on": "page",
      "confirm": {
        "question": "Stop infra?",
        "lines": [
          {
            "kind": "text",
            "text": "It stays stopped until you start it: the engine no longer restarts it."
          },
          {
            "kind": "text",
            "text": "Type infra to stop it."
          }
        ],
        "danger": true,
        "type": "infra",
        "yes": "Stop"
      },
      "priority": 2,
      "mutates": true,
      "id": "stop",
      "run": {
        "call": "machines.stop",
        "in": {
          "VM": "infra"
        },
        "target": {
          "name": "mac-mini"
        }
      }
    },
    {
      "label": "Delete",
      "on": "page",
      "confirm": {
        "question": "Delete infra?",
        "lines": [
          {
            "kind": "text",
            "text": "Its disk is erased: nothing of it is kept."
          },
          {
            "kind": "text",
            "text": "Type infra to delete it."
          }
        ],
        "danger": true,
        "type": "infra",
        "yes": "Delete"
      },
      "priority": 3,
      "mutates": true,
      "id": "delete",
      "run": {
        "call": "machines.delete",
        "in": {
          "VM": "infra"
        },
        "target": {
          "name": "mac-mini"
        }
      },
      "destructive": true
    },
    {
      "key": "cmd+t",
      "label": "Open in Terminal",
      "on": "page",
      "priority": 2,
      "id": "open-station",
      "run": {
        "terminal": true,
        "argv": [
          "--on",
          "infra"
        ]
      },
      "icon": "terminal",
      "disabled": "Opens once SSH answers"
    },
    {
      "label": "More options for infra",
      "on": "page",
      "id": "menu",
      "icon": "ellipsis",
      "submenu": [
