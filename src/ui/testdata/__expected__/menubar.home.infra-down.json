  "actions": [
    {
      "key": "cmd+n",
      "label": "New VM",
      "on": "page",
      "priority": 1,
      "mutates": true,
      "id": "new-vm",
      "run": {
        "call": "machines.create-workspace",
        "in": {
          "Request.Image": "linux",
          "Request.Network": "nat"
        }
      },
      "form": {
        "title": "New VM",
        "fields": [
          {
            "key": "Request.Lifetime",
            "label": "Will it last?",
            "kind": "select",
            "options": [
              {
                "value": "throwaway",
                "label": "Throwaway",
                "note": "deleted when it powers off from inside"
              },
              {
                "value": "permanent",
                "label": "Permanent",
                "note": "kept until you delete it"
              }
            ],
            "default": "throwaway"
          },
          {
            "key": "Request.Resources.MemoryBytes",
            "label": "Memory",
            "kind": "select",
            "options": [
              {
                "value": "4294967296",
                "label": "4 GB"
              },
              {
                "value": "8589934592",
                "label": "8 GB"
              }
            ],
            "default": "4294967296"
          }
        ]
      }
    },
    {
      "key": "cmd+t",
      "label": "Open in Terminal",
      "on": "page",
      "priority": 2,
      "id": "open-station",
      "run": {
        "terminal": true
      }
    },
    {
      "label": "Stop everything on This Mac",
      "on": "page",
      "confirm": {
        "question": "Stop everything on This Mac?",
        "lines": [
          {
            "kind": "text",
            "text": "linux-1 will stop; its disk is kept"
          },
          {
            "kind": "text",
            "text": "Awake ends, and the engine stays stopped until station engine start or the next login"
          }
        ],
        "danger": true,
        "yes": "Stop"
      },
      "priority": 3,
      "mutates": true,
      "id": "stop-all",
      "run": {
        "call": "engine.stop",
        "in": {
          "By": "the menu bar",
          "Confirm": "yes"
        }
      }
    },
    {
      "label": "sleep",
      "on": "row",
      "rows": [
        "awake"
      ],
      "priority": 4,
      "mutates": true,
      "id": "power-sleep",
      "run": {
        "call": "awake.off"
      }
    },
    {
      "label": "Update all",
      "on": "row",
      "rows": [
        "0-updates"
      ],
      "priority": 5,
      "mutates": true,
      "id": "update-all",
      "run": {
        "call": "apps.update"
      }
    }
  ],
  "badge": {
    "needs": 5,
