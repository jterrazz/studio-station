  "actions": [
    {
      "label": "New VM",
      "on": "page",
      "priority": 1,
      "mutates": true,
      "id": "new-vm",
      "run": {
        "call": "machines.create",
        "in": {
          "Request.Image": "linux",
          "Request.Network": "nat"
        }
      },
      "form": {
        "title": "New VM",
        "fields": [
          {
            "key": "Request.Lifetime",
            "label": "Lifetime",
            "kind": "select",
            "options": [
              {
                "value": "temporary"
              },
              {
                "value": "lasting"
              }
            ],
            "default": "temporary"
          },
          {
            "key": "Request.Resources.MemoryBytes",
            "label": "Memory",
            "kind": "select",
            "options": [
              {
                "value": "4294967296",
                "label": "4G"
              },
              {
                "value": "8589934592",
                "label": "8G"
              }
            ],
            "default": "4294967296"
          }
        ]
      }
    },
    {
      "label": "Open station",
      "on": "page",
      "priority": 2,
      "id": "open-station",
      "run": {
        "terminal": true
      }
    },
    {
      "label": "Stop everything",
      "on": "page",
      "confirm": {
        "question": "Stop everything on macbook?",
        "lines": [
          {
            "kind": "text",
            "text": "Awake ends, and the engine stays stopped until station engine start or the next login"
          }
        ],
        "danger": true,
        "yes": "Stop"
      },
      "priority": 3,
      "mutates": true,
      "id": "stop-all",
      "run": {
        "call": "engine.stop",
        "in": {
          "By": "the menu bar",
          "Confirm": "yes"
        }
      }
    },
    {
      "label": "awake",
      "on": "row",
      "rows": [
        "awake"
      ],
      "priority": 4,
      "mutates": true,
      "id": "power-awake",
      "run": {
        "call": "power.awake"
      },
      "form": {
        "title": "Power",
        "fields": [
          {
            "key": "For",
            "label": "For",
            "kind": "select",
            "options": [
              {
                "value": "3600000000000",
                "label": "1h"
              },
              {
                "value": "7200000000000",
                "label": "2h"
              },
              {
                "value": "14400000000000",
                "label": "4h"
              },
              {
                "value": "28800000000000",
                "label": "8h"
              },
              {
                "value": "43200000000000",
                "label": "12h"
              },
              {
                "value": "86400000000000",
                "label": "24h"
              }
            ],
            "default": "14400000000000"
          },
          {
            "key": "Lid",
            "label": "Lid",
            "kind": "select",
            "options": [
              {
                "value": "Lid=false",
                "label": "open only"
              },
              {
                "value": "Lid=true",
                "label": "closed"
              },
              {
                "value": "Lid=true Battery=true",
                "label": "closed on battery"
              }
            ],
            "default": "Lid=false"
          }
        ]
      }
    }
