      "id": "open-station",
      "run": {
        "terminal": true,
        "argv": [
          "--on",
          "mac-mini"
        ]
      }
    },
    {
      "label": "More options for mac-mini",
      "on": "page",
      "id": "menu",
      "icon": "ellipsis",
      "submenu": [
        "title:jterrazz-mac-mini",
        "open-station@menu",
        "unlock@menu",
        "-",
        "restart-mac",
        "stop-all:jterrazz-mac-mini",
        "-",
        "forget-mac"
