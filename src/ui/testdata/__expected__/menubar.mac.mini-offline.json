    },
    {
      "id": "https",
      "title": "HTTPS links",
      "columns": [
        {
          "key": "name",
          "kind": "text",
          "keep": 100
        },
        {
          "key": "value",
          "kind": "list",
          "keep": 60
        }
      ],
      "items": [
        {
          "row": {
            "id": "https",
            "mark": "ok",
            "label": "HTTPS links on mac-mini",
            "cells": [
              {
                "kind": "on"
              }
            ],
            "glyph": {
              "kind": "symbol:lock"
            },
            "verb": "https:jterrazz-mac-mini"
          }
        }
      ],
      "counts": [
        {
          "mark": "ok",
          "n": 1
        }
      ],
      "segment": "ports",
      "card": "flush"
    },
    {
      "id": "accounts",
      "title": "Accounts",
      "columns": [
        {
          "key": "name",
          "kind": "text",
          "keep": 100
        },
        {
          "key": "value",
          "kind": "list",
          "keep": 60
        }
      ],
      "items": [
        {
          "empty": {
            "text": "No account shared"
          }
        }
      ],
      "segment": "accounts"
    }
  ],
  "actions": [
    {
      "key": "cmd+n",
      "label": "New VM",
      "on": "page",
      "priority": 1,
      "mutates": true,
      "id": "new-vm",
      "run": {
        "call": "machines.create-workspace",
        "in": {
          "Request.Image": "linux",
          "Request.Network": "nat"
        },
        "target": {
          "name": "jterrazz-mac-mini"
        }
      },
      "form": {
        "title": "New VM",
        "fields": [
          {
            "key": "Request.Lifetime",
            "label": "Will it last?",
            "kind": "select",
            "options": [
              {
                "value": "throwaway",
                "label": "Throwaway",
                "note": "Deleted when it powers off from inside."
              },
              {
                "value": "permanent",
                "label": "Permanent",
                "note": "Kept until you delete it."
              }
            ],
            "default": "throwaway"
          },
          {
            "key": "Request.Size.MemoryBytes",
            "label": "Memory",
            "kind": "select",
            "options": [
              {
                "value": "4294967296",
                "label": "4 GB"
              },
              {
                "value": "8589934592",
                "label": "8 GB"
              }
            ],
            "default": "4294967296"
          }
        ]
      },
      "icon": "plus"
    },
    {
      "key": "cmd+enter",
      "label": "Open infra in Terminal",
      "on": "row",
      "rows": [
        "infra"
      ],
      "priority": 2,
      "id": "attach:infra",
      "run": {
        "terminal": true,
        "argv": [
          "--on",
          "infra"
        ],
        "target": {
          "name": "jterrazz-mac-mini"
        }
      },
      "icon": "terminal"
    },
    {
      "label": "HTTPS links on mac-mini",
      "on": "row",
      "rows": [
        "https"
      ],
      "mutates": true,
      "id": "https:jterrazz-mac-mini",
      "run": {
        "call": "ports.set-https",
        "in": {
          "On": "false"
        },
        "target": {
          "name": "jterrazz-mac-mini"
        }
      }
    },
    {
      "label": "Unlock the disk",
      "on": "page",
      "priority": 1,
      "mutates": true,
      "id": "unlock",
      "run": {
        "terminal": true,
        "argv": [
          "machines",
          "unlock",
          "mac-mini"
        ]
      }
    },
    {
      "key": "cmd+t",
      "label": "Open in Terminal",
      "on": "page",
      "priority": 2,
      "id": "open-station",
      "run": {
        "terminal": true,
        "argv": [
          "--on",
          "mac-mini"
        ]
      }
    },
    {
      "label": "More options for mac-mini",
      "on": "page",
      "id": "menu",
      "icon": "ellipsis",
      "submenu": [
        "unlock",
        "open-station"
      ]
    }
  ],
  "header": {
    "back": "All machines",
    "glyph": {
      "kind": "desktop"
    },
    "buttons": [
      "new-vm",
      "menu"
    ],
    "stale": {
      "kind": "list",
      "items": [
        {
          "kind": "text",
          "text": "checking"
        }
      ]
    }
  },
  "segments": [
    {
      "id": "overview",
      "label": "Overview",
      "picked": true
    },
    {
      "id": "activity",
      "label": "Activity",
      "key": "cmd+i"
    },
    {
      "id": "ports",
      "label": "Ports",
      "key": "cmd+p"
    },
    {
      "id": "accounts",
      "label": "Accounts",
      "key": "cmd+u"
    }
  ],
  "live": [
    "cpuh:infra",
    "cpu:jterrazz-mac-mini",
    "memory:jterrazz-mac-mini",
    "disk:jterrazz-mac-mini",
    "free:jterrazz-mac-mini",
    "net:jterrazz-mac-mini"
  ]
}
