          "kind": "text",
          "text": "0"
        }
      ],
      "columns": [
        {
          "key": "name",
          "kind": "text",
          "keep": 100
        },
        {
          "key": "value",
          "kind": "list",
          "keep": 60
        }
      ],
      "items": [
        {
          "empty": {
            "text": "Nothing shared yet"
          }
        }
      ],
