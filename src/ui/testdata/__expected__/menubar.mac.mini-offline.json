    {
      "label": "mac-mini",
      "on": "menu",
      "id": "title:jterrazz-mac-mini"
    },
    {
      "key": "cmd+t",
      "label": "Open in Terminal",
      "on": "menu",
      "priority": 2,
      "id": "open-station@menu",
      "run": {
        "terminal": true,
        "argv": [
          "--on",
          "mac-mini"
        ]
      },
      "icon": "terminal"
    },
    {
      "label": "Unlock the disk",
      "on": "menu",
