{
  "schema": "station.page/v1",
  "id": "menubar.ports",
  "command": "menubar",
  "context": {
    "machine": "jterrazz-macbook-pro",
    "kind": "mac"
  },
  "state": "ready",
  "sections": [
    {
      "id": "summary",
      "title": "Ports",
      "role": "summary",
      "caption": [
        {
          "kind": "text",
          "text": "mac-mini"
        },
        {
          "kind": "text",
          "text": "1 public"
        },
        {
          "kind": "text",
          "text": "2 on your tailnet"
        },
        {
          "kind": "text",
          "text": "2 exposed",
          "signal": "failing"
        }
      ]
    },
    {
      "id": "exposed",
      "title": "Exposed",
      "caption": [
        {
          "kind": "text",
          "text": "reachable outside Tailscale",
          "signal": "failing"
        }
      ],
      "columns": [
        {
          "key": "name",
          "kind": "text",
          "keep": 100
        },
        {
          "key": "value",
          "kind": "list",
          "keep": 60
        }
      ],
      "items": [
        {
          "row": {
            "id": "mac-mini:5000",
            "mark": "broken",
            "label": "5000",
            "cells": [
              {
                "kind": "text",
                "text": "AirPlay Receiver"
              }
            ],
            "detail": {
              "kind": "list",
              "items": [
                {
                  "kind": "text",
                  "text": "mac-mini"
                },
                {
                  "kind": "text",
                  "text": "on your network, not declared"
                }
              ]
            },
            "reason": "exposed",
            "glyph": {
              "kind": "symbol:exclamationmark.shield",
              "signal": "failing"
            },
            "menu": [
              "declare-public",
              "show-process:mac-mini:5000"
            ]
          }
        },
        {
          "row": {
            "id": "infra:10250",
            "mark": "broken",
            "label": "10250",
            "cells": [
              {
                "kind": "text",
                "text": "kubelet"
              }
            ],
            "detail": {
              "kind": "list",
              "items": [
                {
                  "kind": "text",
                  "text": "infra"
                },
                {
                  "kind": "text",
                  "text": "on your network, not declared"
                }
              ]
            },
            "reason": "exposed",
            "glyph": {
              "kind": "symbol:exclamationmark.shield",
              "signal": "failing"
            },
            "menu": [
              "declare-public",
              "show-process:infra:10250"
            ]
          }
        }
      ],
      "counts": [
        {
          "mark": "broken",
          "n": 2
        }
      ],
      "card": "exposed"
    },
    {
      "id": "public",
      "title": "Public",
      "caption": [
        {
          "kind": "text",
          "text": "1"
        }
      ],
      "columns": [
        {
          "key": "name",
          "kind": "text",
          "keep": 100
        },
        {
          "key": "value",
          "kind": "list",
          "keep": 60
        }
      ],
      "items": [
        {
          "row": {
            "id": "infra:443",
            "mark": "ok",
            "label": "Traefik",
            "detail": {
              "kind": "list",
              "items": [
                {
                  "kind": "text",
                  "text": "jterrazz.com"
                },
                {
                  "kind": "text",
                  "text": "Cloudflare Tunnel"
                }
              ]
            },
            "glyph": {
              "kind": "port:traefik"
            },
            "mac": "infra",
            "verb": "open-port:infra:443",
            "quick": "qr:infra:443"
          }
        }
      ],
      "counts": [
        {
          "mark": "ok",
          "n": 1
        }
      ],
      "glance": [
        {
          "kind": "text",
          "text": "Public"
        },
        {
          "kind": "text",
          "text": "from outside"
        }
      ]
    },
    {
      "id": "private",
      "title": "Private",
      "caption": [
        {
          "kind": "text",
          "text": "2"
        }
      ],
      "columns": [
        {
          "key": "name",
          "kind": "text",
          "keep": 100
        },
        {
          "key": "value",
          "kind": "list",
          "keep": 60
        }
      ],
      "items": [
        {
          "row": {
            "id": "infra:6443",
            "mark": "ok",
            "label": "Kubernetes API",
            "detail": {
              "kind": "text",
              "text": "infra:6443"
            },
            "glyph": {
              "kind": "port:kubernetes"
            },
            "verb": "copy-port:infra:6443"
          }
        },
        {
          "row": {
            "id": "mac-mini:5900",
            "mark": "ok",
            "label": "Screen Sharing",
            "detail": {
              "kind": "text",
              "text": "mac-mini:5900"
            },
            "glyph": {
              "kind": "port:web"
            },
            "verb": "copy-port:mac-mini:5900"
          }
        }
      ],
      "counts": [
        {
          "mark": "ok",
          "n": 2
        }
      ],
      "glance": [
        {
          "kind": "text",
          "text": "Private"
        },
        {
          "kind": "text",
          "text": "on your tailnet"
        }
      ]
    }
  ],
  "actions": [
    {
      "label": "Show process",
      "on": "row",
      "rows": [
        "mac-mini:5000"
      ],
      "priority": 1,
      "id": "show-process:mac-mini:5000",
      "run": {
        "terminal": true,
        "argv": [
          "ports",
          "--on",
          "mac-mini"
        ]
      }
    },
    {
      "label": "Show process",
      "on": "row",
      "rows": [
        "infra:10250"
      ],
      "priority": 1,
      "id": "show-process:infra:10250",
      "run": {
        "terminal": true,
        "argv": [
          "ports",
          "--on",
          "mac-mini"
        ]
      }
    },
    {
      "label": "Open Traefik",
      "on": "row",
      "rows": [
        "infra:443"
      ],
      "id": "open-port:infra:443",
      "run": {
        "open": "https://jterrazz.com"
      }
    },
    {
      "label": "Copy link to Traefik",
      "on": "row",
      "rows": [
        "infra:443"
      ],
      "id": "copy-port:infra:443",
      "run": {
        "copy": "https://jterrazz.com"
      },
      "hud": {
        "kind": "list",
        "items": [
          {
            "kind": "text",
            "text": "Copied https://jterrazz.com"
          }
        ]
      }
    },
    {
      "label": "Show QR for Traefik",
      "on": "row",
      "rows": [
        "infra:443"
      ],
      "id": "qr:infra:443",
      "icon": "qrcode"
    },
    {
      "label": "Copy link to Screen Sharing",
      "on": "row",
      "rows": [
        "mac-mini:5900"
      ],
      "id": "copy-port:mac-mini:5900",
      "run": {
        "copy": "mac-mini:5900"
      },
      "hud": {
        "kind": "list",
        "items": [
          {
            "kind": "text",
            "text": "Copied mac-mini:5900"
          }
        ]
      }
    },
    {
      "label": "Copy link to Kubernetes API",
      "on": "row",
      "rows": [
        "infra:6443"
      ],
      "id": "copy-port:infra:6443",
      "run": {
        "copy": "infra:6443"
      },
      "hud": {
        "kind": "list",
        "items": [
          {
            "kind": "text",
            "text": "Copied infra:6443"
          }
        ]
      }
    },
    {
      "label": "Declare public",
      "on": "page",
      "priority": 2,
      "mutates": true,
      "id": "declare-public",
      "run": {
        "call": "ports.declare"
      },
      "form": {
        "title": "Declare a port public",
        "fields": [
          {
            "key": "Port",
            "label": "Port",
            "kind": "select",
            "options": [
              {
                "value": "Machine=\"mac-mini\" Port=\"5000\"",
                "label": "mac-mini:5000"
              },
              {
                "value": "Machine=\"infra\" Port=\"10250\"",
                "label": "infra:10250"
              },
              {
                "value": "Machine=\"mac-mini\" Port=\"5900\"",
                "label": "mac-mini:5900"
              },
              {
                "value": "Machine=\"infra\" Port=\"6443\"",
                "label": "infra:6443"
              }
            ],
            "default": "Machine=\"mac-mini\" Port=\"5000\"",
            "required": true
          },
          {
            "key": "Via",
            "label": "Via",
            "kind": "select",
            "options": [
              {
                "value": "cloudflare-tunnel",
                "label": "Cloudflare Tunnel"
              },
              {
                "value": "tailscale-funnel",
                "label": "Tailscale Funnel"
              },
              {
                "value": "lan",
                "label": "your LAN"
              }
            ],
            "default": "cloudflare-tunnel",
            "required": true
          }
        ]
      }
    },
    {
      "label": "Share a port",
      "on": "page",
      "priority": 3,
      "mutates": true,
      "id": "share-port",
      "run": {
        "call": "ports.share"
      },
      "form": {
        "title": "Share a port",
        "fields": [
          {
            "key": "VM",
            "label": "Of",
            "kind": "select",
            "options": [
              {
                "value": "infra",
                "label": "infra"
              }
            ],
            "default": "infra",
            "required": true
          },
          {
            "key": "Port",
            "label": "Port",
            "kind": "text",
            "note": "a port number, like 5173",
            "required": true
          }
        ],
        "subtitle": "Private on your tailnet."
      },
      "sheet": "share-port"
    },
    {
      "label": "Full list in Terminal",
      "on": "page",
      "id": "full-list",
      "run": {
        "terminal": true,
        "argv": [
          "ports",
          "--on",
          "mac-mini"
        ]
      }
    },
    {
      "label": "More options for Ports",
      "on": "page",
      "id": "menu",
      "icon": "ellipsis",
      "submenu": [
        "share-port",
        "declare-public"
      ]
    }
  ],
  "header": {
    "back": "All machines",
    "glyph": {
      "kind": "symbol:network"
    },
    "buttons": [
      "menu"
    ]
  },
  "footer": {
    "kind": "terminal-list",
    "buttons": [
      "full-list",
      "share-port"
    ]
  }
}
