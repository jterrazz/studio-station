        ],
        "danger": true,
        "yes": "Stop sharing",
        "no": "Cancel"
      },
      "priority": 3,
      "mutates": true,
      "id": "stop-sharing:linux-1/5173",
      "run": {
        "call": "ports.stop-sharing",
        "in": {
          "Confirm": "yes",
          "Mac": "\"jterrazz-macbook-pro\"",
          "Port": "\"5173\"",
          "VM": "\"linux-1\""
        }
      }
    },
