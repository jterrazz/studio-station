      "priority": 1,
      "mutates": true,
      "id": "stop",
      "run": {
        "call": "machines.stop",
        "in": {
          "Confirm": "yes",
          "VM": "linux-1"
        }
      }
    },
    {
      "label": "Delete",
      "on": "page",
      "confirm": {
        "question": "Delete linux-1?",
        "lines": [
          {
            "kind": "text",
            "text": "Its disk is erased: nothing of it is kept."
          },
          {
            "kind": "text",
            "text": "Type linux-1 to delete it."
          }
        ],
        "danger": true,
        "type": "linux-1",
        "yes": "Delete"
      },
      "priority": 2,
      "mutates": true,
      "id": "delete",
      "run": {
        "call": "machines.delete",
        "in": {
          "VM": "linux-1"
        }
      }
    },
    {
      "key": "shift+cmd+n",
      "label": "New agent",
      "on": "page",
      "priority": 2,
      "mutates": true,
      "id": "new-agent",
