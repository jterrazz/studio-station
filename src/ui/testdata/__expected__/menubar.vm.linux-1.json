      "priority": 4,
      "mutates": true,
      "id": "take-back/claude",
      "run": {
        "call": "accounts.take-back",
        "in": {
          "Account": "claude",
          "Confirm": "yes",
          "From": "linux-1"
        }
      }
    },
    {
      "label": "Stop sharing",
      "on": "row",
      "rows": [
        "5173"
      ],
      "confirm": {
        "question": "Stop sharing linux-1's port 5173?",
        "lines": [
          {
            "kind": "text",
            "text": "Its link stops working on Tailscale, and reserved port 40001 is let go."
