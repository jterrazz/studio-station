      "icon": "plus"
    },
    {
      "label": "Share a port",
      "on": "page",
      "priority": 3,
      "mutates": true,
      "id": "share-port",
      "run": {
        "call": "ports.share",
        "in": {
          "VM": "linux-1"
        }
      },
      "form": {
        "title": "Share a port of linux-1",
        "fields": [
          {
            "key": "Port",
            "label": "Port",
            "kind": "text",
            "note": "a port number, like 5173",
            "required": true
          }
        ]
      }
    },
