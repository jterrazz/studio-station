            "kind": "text",
            "text": "Its copy on linux-1 is deleted."
          }
        ],
        "yes": "Take back"
      },
      "priority": 4,
      "mutates": true,
      "id": "take-back/github",
      "run": {
        "call": "accounts.take-back",
        "in": {
          "Account": "github",
          "Confirm": "yes",
          "From": "linux-1"
        }
      }
    },
