{
  "schema": "station.page/v1",
  "id": "menubar.machine",
  "command": "menubar",
  "context": {
    "machine": "jterrazz-mac-mini",
    "kind": "mac"
  },
  "state": "loading",
  "sections": [
    {
      "id": "summary",
      "title": "mac-mini",
      "role": "summary"
    },
    {
      "id": "gauges",
      "title": "Gauges",
      "items": [
        {
          "gauge": {
            "title": "CPU",
            "value": {
              "kind": "pending",
              "live": "cpu:jterrazz-mac-mini"
            }
          }
        },
        {
          "gauge": {
            "title": "Memory",
            "value": {
              "kind": "pending",
              "live": "free:jterrazz-mac-mini"
            }
          }
        },
        {
          "gauge": {
            "title": "Network",
            "value": {
              "kind": "pending",
              "live": "net:jterrazz-mac-mini"
            }
          }
        }
      ],
      "segment": "overview",
      "card": "gauges"
    },
    {
      "id": "vms",
      "title": "VMs",
      "columns": [
        {
          "key": "name",
          "kind": "text",
          "keep": 100
        },
        {
          "key": "cpu",
          "kind": "percent",
          "keep": 20
        }
      ],
      "items": [
        {
          "row": {
            "id": "infra",
            "mark": "ok",
            "label": "infra",
            "cells": [
              {
                "kind": "none",
                "live": "cpuh:infra"
              }
            ],
            "detail": {
              "kind": "list",
              "items": [
                {
                  "kind": "text",
                  "text": "healthy"
                },
                {
                  "kind": "text",
                  "text": "up 12 days"
                }
              ]
            },
            "glyph": {
              "signal": "well",
              "dot": "fill"
            },
            "trail": "cpu",
            "quick": "attach:infra",
            "nav": "menubar.machine:infra"
          }
        }
      ],
      "uncounted": true,
      "segment": "overview",
      "card": "flush"
    },
    {
      "id": "care",
      "title": "Care",
      "columns": [
        {
          "key": "name",
          "kind": "text",
          "keep": 100
        },
        {
          "key": "value",
          "kind": "list",
          "keep": 60
        }
      ],
      "items": [
        {
          "group": {
            "head": {
              "id": "upkeep",
              "mark": "ok",
              "label": "Upkeep",
              "cells": [
                {
                  "kind": "text",
                  "text": "all fine"
                }
              ],
              "glyph": {
                "kind": "symbol:wrench.adjustable",
                "signal": "quiet"
              },
              "trail": "value"
            },
            "items": [
              {
                "row": {
                  "id": "ready",
                  "mark": "ok",
                  "label": "Ready to host servers",
                  "detail": {
                    "kind": "text",
                    "text": "6 of 6"
                  },
                  "glyph": {
                    "kind": "symbol:lock",
                    "signal": "quiet"
                  }
                }
              }
            ],
            "fold": "folded"
          }
        }
      ],
      "uncounted": true,
      "segment": "overview",
      "card": "care"
    },
    {
      "id": "activity",
      "title": "Activity",
      "role": "summary",
      "columns": [
        {
          "key": "name",
          "kind": "text",
          "keep": 100
        },
        {
          "key": "value",
          "kind": "list",
          "keep": 60
        },
        {
          "key": "graph",
          "kind": "spark",
          "keep": 50
        }
      ],
      "items": [
        {
          "row": {
            "id": "cpu",
            "label": "CPU",
            "cells": [
              {
                "kind": "pending",
                "live": "cpu:jterrazz-mac-mini"
              }
            ]
          }
        },
        {
          "row": {
            "id": "memory",
            "label": "Memory",
            "cells": [
              {
                "kind": "pending",
                "live": "memory:jterrazz-mac-mini"
              }
            ]
          }
        },
        {
          "row": {
            "id": "disk",
            "label": "Disk",
            "cells": [
              {
                "kind": "pending",
                "live": "disk:jterrazz-mac-mini"
              }
            ]
          }
        }
      ],
      "segment": "activity"
    },
    {
      "id": "ports",
      "title": "Ports",
      "items": [
        {
          "empty": {
            "text": "No port shared yet"
          }
        }
      ],
      "uncounted": true,
      "segment": "ports"
    },
    {
      "id": "accounts:shared",
      "title": "Lent to VMs",
      "caption": [
        {
          "kind": "text",
          "text": "0"
        }
      ],
      "columns": [
        {
          "key": "name",
          "kind": "text",
          "keep": 100
        },
        {
          "key": "value",
          "kind": "list",
          "keep": 60
        }
      ],
      "items": [
        {
          "row": {
            "id": "share-account",
            "mark": "ok",
            "label": "Lend an account",
            "cells": [
              {
                "kind": "text",
                "text": "ends by itself"
              }
            ],
            "glyph": {
              "kind": "symbol:plus",
              "signal": "active"
            },
            "trail": "value",
            "verb": "share-account"
          }
        }
      ],
      "counts": [
        {
          "mark": "ok",
          "n": 1
        }
      ],
      "segment": "accounts",
      "card": "flush"
    }
  ],
  "actions": [
    {
      "key": "cmd+n",
      "label": "New VM",
      "on": "page",
      "priority": 1,
      "mutates": true,
      "id": "new-vm",
      "run": {
        "call": "machines.create-workspace",
        "in": {
          "Request.Image": "linux",
          "Request.Network": "nat"
        },
        "target": {
          "name": "jterrazz-mac-mini"
        }
      },
      "form": {
        "title": "New VM",
        "fields": [
          {
            "key": "Request.Lifetime",
            "label": "Will it last?",
            "kind": "select",
            "options": [
              {
                "value": "throwaway",
                "label": "Throwaway",
                "note": "Deleted when it powers off from inside."
              },
              {
                "value": "permanent",
                "label": "Permanent",
                "note": "Kept until you delete it."
              }
            ],
            "default": "throwaway"
          },
          {
            "key": "Request.Size.MemoryBytes",
            "label": "Memory",
            "kind": "select",
            "options": [
              {
                "value": "4294967296",
                "label": "4 GB"
              },
              {
                "value": "8589934592",
                "label": "8 GB"
              }
            ],
            "default": "4294967296"
          }
        ]
      },
      "icon": "plus"
    },
    {
      "key": "cmd+enter",
      "label": "Open infra in Terminal",
      "on": "row",
      "rows": [
        "infra"
      ],
      "priority": 2,
      "id": "attach:infra",
      "run": {
        "terminal": true,
        "argv": [
          "--on",
          "infra"
        ],
        "target": {
          "name": "jterrazz-mac-mini"
        }
      },
      "icon": "terminal"
    },
    {
      "label": "Lend an account",
      "on": "row",
      "rows": [
        "share-account"
      ],
      "mutates": true,
      "id": "share-account",
      "run": {
        "call": "accounts.share",
        "target": {
          "name": "jterrazz-mac-mini"
        }
      },
      "form": {
        "title": "Lend an account",
        "fields": [
          {
            "key": "With",
            "label": "To",
            "kind": "text",
            "required": true
          },
          {
            "key": "Account",
            "label": "Account",
            "kind": "text",
            "required": true
          },
          {
            "key": "For",
            "label": "For",
            "kind": "segmented",
            "options": [
              {
                "value": "14400000000000",
                "label": "4 hr"
              },
              {
                "value": "43200000000000",
                "label": "12 hr"
              },
              {
                "value": "604800000000000",
                "label": "7 days"
              }
            ],
            "default": "14400000000000"
          }
        ],
        "subtitle": "From mac-mini. It ends by itself."
      },
      "sheet": "share-account"
    },
    {
      "key": "cmd+t",
      "label": "Open in Terminal",
      "on": "page",
      "priority": 2,
      "id": "open-station",
      "run": {
        "terminal": true,
        "argv": [
          "--on",
          "mac-mini"
        ]
      }
    },
    {
      "label": "More options for mac-mini",
      "on": "page",
      "id": "menu",
      "icon": "ellipsis",
      "submenu": [
        "open-station"
      ]
    }
  ],
  "header": {
    "back": "All machines",
    "glyph": {
      "kind": "desktop"
    },
    "buttons": [
      "new-vm",
      "menu"
    ]
  },
  "segments": [
    {
      "id": "overview",
      "label": "Overview",
      "picked": true
    },
    {
      "id": "activity",
      "label": "Activity",
      "key": "cmd+i"
    },
    {
      "id": "ports",
      "label": "Ports",
      "key": "cmd+p"
    },
    {
      "id": "accounts",
      "label": "Accounts",
      "key": "cmd+u"
    }
  ],
  "live": [
    "cpuh:infra",
    "cpu:jterrazz-mac-mini",
    "memory:jterrazz-mac-mini",
    "disk:jterrazz-mac-mini",
    "free:jterrazz-mac-mini",
    "net:jterrazz-mac-mini"
  ]
}
