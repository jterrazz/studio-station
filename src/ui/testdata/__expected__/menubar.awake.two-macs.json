{
  "schema": "station.page/v1",
  "id": "menubar.awake",
  "command": "awake",
  "context": {
    "machine": "jterrazz-macbook-pro",
    "kind": "mac"
  },
  "state": "ready",
  "sections": [
    {
      "id": "summary",
      "title": "Awake",
      "role": "summary",
      "caption": [
        {
          "kind": "text",
          "text": "All Macs"
        },
        {
          "kind": "text",
          "text": "which may sleep, and what pauses"
        }
      ]
    },
    {
      "id": "this-mac",
      "title": "This Mac",
      "columns": [
        {
          "key": "name",
          "kind": "text",
          "keep": 100
        },
        {
          "key": "state",
          "kind": "text",
          "keep": 100
        }
      ],
      "items": [
        {
          "row": {
            "id": "jterrazz-macbook-pro",
            "mark": "ok",
            "label": "Keep This Mac awake",
            "cells": [
              {
                "kind": "on"
              }
            ],
            "detail": {
              "kind": "text",
              "text": "Stays on after agents finish"
            },
            "glyph": {
              "kind": "symbol:sun.max",
              "signal": "waits"
            },
            "verb": "let-sleep"
          }
        },
        {
          "row": {
            "id": "lid",
            "mark": "ok",
            "label": "Stay awake with the lid closed",
            "cells": [
              {
                "kind": "on"
              }
            ],
            "glyph": {
              "kind": "symbol:laptopcomputer",
              "signal": "quiet"
            },
            "verb": "lid"
          }
        },
        {
          "row": {
            "id": "battery",
            "mark": "ok",
            "label": "Stay awake on battery",
            "cells": [
              {
                "kind": "off"
              }
            ],
            "glyph": {
              "kind": "symbol:battery.75percent",
              "signal": "quiet"
            },
            "verb": "battery"
          }
        }
      ],
      "uncounted": true,
      "card": "flush"
    },
    {
      "id": "mac-mini",
      "title": "mac-mini",
      "columns": [
        {
          "key": "name",
          "kind": "text",
          "keep": 100
        },
        {
          "key": "state",
          "kind": "text",
          "keep": 100
        }
      ],
      "items": [
        {
          "row": {
            "id": "mac-mini",
            "mark": "ok",
            "label": "Never sleeps",
            "cells": [
              {
                "kind": "on"
              }
            ],
            "detail": {
              "kind": "text",
              "text": "hosts infra, which pauses if it sleeps"
            },
            "glyph": {
              "kind": "symbol:sun.max",
              "signal": "waits"
            },
            "verb": "change:mac-mini"
          }
        }
      ],
      "uncounted": true,
      "card": "flush"
    }
  ],
  "actions": [
    {
      "label": "1 hr",
      "on": "row",
      "rows": [
        "jterrazz-macbook-pro"
      ],
      "priority": 1,
      "mutates": true,
      "id": "keep:1h",
      "run": {
        "call": "awake.keep",
        "in": {
          "Battery": "false",
          "By": "the menu bar",
          "For": "3600000000000",
          "Lid": "true"
        }
      }
    },
    {
      "label": "4 hr",
      "on": "row",
      "rows": [
        "jterrazz-macbook-pro"
      ],
      "priority": 1,
      "mutates": true,
      "id": "keep:4h",
      "run": {
        "call": "awake.keep",
        "in": {
          "Battery": "false",
          "By": "the menu bar",
          "For": "14400000000000",
          "Lid": "true"
        }
      }
    },
    {
      "label": "Until 18:00",
      "on": "row",
      "rows": [
        "jterrazz-macbook-pro"
      ],
      "priority": 1,
      "mutates": true,
      "id": "keep-until",
      "run": {
        "call": "awake.keep",
        "in": {
          "Battery": "false",
          "By": "the menu bar",
          "Lid": "true"
        }
      },
      "form": {
        "title": "Keep awake until",
        "fields": [
          {
            "key": "Until",
            "label": "Until",
            "kind": "select",
            "options": [
              {
                "value": "\"2026-11-03T12:00:00Z\"",
                "label": "12:00"
              },
              {
                "value": "\"2026-11-03T13:00:00Z\"",
                "label": "13:00"
              },
              {
                "value": "\"2026-11-03T14:00:00Z\"",
                "label": "14:00"
              },
              {
                "value": "\"2026-11-03T15:00:00Z\"",
                "label": "15:00"
              },
              {
                "value": "\"2026-11-03T16:00:00Z\"",
                "label": "16:00"
              },
              {
                "value": "\"2026-11-03T17:00:00Z\"",
                "label": "17:00"
              },
              {
                "value": "\"2026-11-03T18:00:00Z\"",
                "label": "18:00"
              },
              {
                "value": "\"2026-11-03T19:00:00Z\"",
                "label": "19:00"
              }
            ],
            "default": "\"2026-11-03T18:00:00Z\""
          }
        ]
      },
      "picked": true
    },
    {
      "label": "Lid closed",
      "on": "row",
      "rows": [
        "jterrazz-macbook-pro"
      ],
      "priority": 2,
      "mutates": true,
      "id": "lid",
      "run": {
        "call": "awake.keep",
        "in": {
          "Battery": "false",
          "By": "the menu bar",
          "Lid": "false",
          "Until": "\"2026-11-03T18:00:00Z\""
        }
      }
    },
    {
      "label": "On battery",
      "on": "row",
      "rows": [
        "jterrazz-macbook-pro"
      ],
      "priority": 2,
      "mutates": true,
      "id": "battery",
      "run": {
        "call": "awake.keep",
        "in": {
          "Battery": "true",
          "By": "the menu bar",
          "Lid": "true",
          "Until": "\"2026-11-03T18:00:00Z\""
        }
      }
    },
    {
      "label": "Let it sleep",
      "on": "row",
      "rows": [
        "jterrazz-macbook-pro"
      ],
      "priority": 3,
      "mutates": true,
      "id": "let-sleep",
      "run": {
        "call": "awake.off"
      }
    },
    {
      "label": "Change",
      "on": "row",
      "rows": [
        "mac-mini"
      ],
      "confirm": {
        "question": "Let mac-mini sleep again?",
        "lines": [
          {
            "kind": "text",
            "text": "It hosts infra (server): infra pauses while mac-mini sleeps."
          }
        ],
        "danger": true,
        "yes": "Allow sleep",
        "no": "Keep it awake"
      },
      "priority": 2,
      "mutates": true,
      "id": "change:mac-mini",
      "run": {
        "call": "settings.off",
        "in": {
          "Confirm": "yes",
          "Names": "[\"never-sleeps\"]"
        },
        "target": {
          "name": "mac-mini"
        }
      }
    }
  ],
  "header": {
    "back": "All machines",
    "glyph": {
      "kind": "symbol:sun.max",
      "signal": "quiet"
    }
  }
}
