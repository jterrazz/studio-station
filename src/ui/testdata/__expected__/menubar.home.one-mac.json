  "actions": [
    {
      "key": "cmd+n",
      "label": "New VM",
      "on": "page",
      "priority": 1,
      "mutates": true,
      "id": "new-vm",
      "run": {
        "call": "machines.create-workspace",
        "in": {
          "Request.Image": "linux",
          "Request.Network": "nat"
        }
      },
      "form": {
        "title": "New VM",
        "fields": [
          {
            "key": "Request.Lifetime",
            "label": "Will it last?",
            "kind": "select",
            "options": [
              {
                "value": "throwaway",
                "label": "Throwaway",
                "note": "deleted when it powers off from inside"
              },
              {
                "value": "permanent",
                "label": "Permanent",
                "note": "kept until you delete it"
              }
            ],
            "default": "throwaway"
          },
          {
            "key": "Request.Resources.MemoryBytes",
            "label": "Memory",
            "kind": "select",
            "options": [
              {
                "value": "4294967296",
                "label": "4 GB"
              },
              {
                "value": "8589934592",
                "label": "8 GB"
              }
            ],
            "default": "4294967296"
          }
        ]
      }
    },
    {
      "key": "cmd+t",
      "label": "Open in Terminal",
      "on": "page",
      "priority": 2,
      "id": "open-station",
      "run": {
        "terminal": true
      }
    },
    {
      "label": "Stop everything on This Mac",
      "on": "page",
      "confirm": {
        "question": "Stop everything on This Mac?",
        "lines": [
          {
            "kind": "text",
            "text": "Awake ends, and the engine stays stopped until station engine start or the next login"
          }
        ],
        "danger": true,
        "yes": "Stop"
      },
      "priority": 3,
      "mutates": true,
      "id": "stop-all",
      "run": {
        "call": "engine.stop",
        "in": {
          "By": "the menu bar",
          "Confirm": "yes"
        }
      }
    },
    {
      "label": "awake",
      "on": "row",
      "rows": [
        "awake"
      ],
      "priority": 4,
      "mutates": true,
      "id": "power-awake",
      "run": {
        "call": "awake.keep"
      },
      "form": {
        "title": "Awake",
        "fields": [
          {
            "key": "For",
            "label": "Keep awake for",
            "kind": "select",
            "options": [
              {
                "value": "3600000000000",
                "label": "1 h"
              },
              {
                "value": "14400000000000",
                "label": "4 h"
              },
              {
                "value": "28800000000000",
                "label": "8 h"
              }
            ],
            "default": "14400000000000"
          },
          {
            "key": "Lid",
            "label": "Lid",
            "kind": "select",
            "options": [
              {
                "value": "Lid=false",
                "label": "open only"
              },
              {
                "value": "Lid=true",
                "label": "closed"
              },
              {
                "value": "Lid=true Battery=true",
                "label": "closed on battery"
              }
            ],
            "default": "Lid=false"
          }
        ]
      }
    },
    {
      "label": "Accounts",
      "on": "row",
      "rows": [
        "accounts"
      ],
      "priority": 6,
      "id": "open-accounts",
      "run": {
        "terminal": true,
        "argv": [
          "accounts"
        ]
      }
    }
  ],
  "badge": {
    "needs": 0
  }
