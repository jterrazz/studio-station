    {
      "label": "Stop",
      "on": "page",
      "confirm": {
        "question": "Stop linux-1?",
        "lines": [
          {
            "kind": "text",
            "text": "Its disk is kept"
          }
        ],
        "yes": "Stop"
      },
      "priority": 1,
      "mutates": true,
      "id": "stop",
      "run": {
        "call": "machines.stop",
        "in": {
          "Confirm": "yes",
          "VM": "linux-1"
        }
      }
    },
    {
      "label": "Delete",
      "on": "page",
      "confirm": {
        "question": "Delete linux-1?",
        "lines": [
          {
            "kind": "text",
            "text": "Its disk is erased: nothing of it is kept"
          },
          {
            "kind": "text",
            "text": "Type linux-1 to delete it"
          }
        ],
        "danger": true,
        "type": "linux-1",
        "yes": "Delete"
      },
      "priority": 2,
      "mutates": true,
      "id": "delete",
      "run": {
        "call": "machines.delete",
        "in": {
          "VM": "linux-1"
        }
      }
    },
    {
      "label": "Share a port",
      "on": "page",
      "priority": 3,
      "mutates": true,
      "id": "share-port",
      "run": {
        "call": "ports.share",
        "in": {
          "VM": "linux-1"
        }
      },
      "form": {
        "title": "Share a port of linux-1",
        "fields": [
          {
            "key": "Port",
            "label": "Port",
            "kind": "text",
            "note": "private, on Tailscale",
            "required": true
          }
        ]
      }
    },
