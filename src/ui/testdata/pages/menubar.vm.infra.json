  "actions": [
    {
      "label": "Restart",
      "on": "page",
      "confirm": {
        "question": "Restart infra on mac-mini?",
        "lines": [
          {
            "kind": "text",
            "text": "infra is unreachable for about a minute while it boots. Its health checks run again after the boot."
          }
        ],
        "yes": "Restart infra",
        "no": "Cancel",
        "icon": "app"
      },
      "priority": 1,
      "mutates": true,
      "id": "restart",
      "run": {
        "call": "machines.restart",
        "in": {
          "Name": "infra"
        },
        "target": {
          "name": "jterrazz-mac-mini"
        }
      }
    },
    {
      "label": "Stop",
      "on": "page",
      "confirm": {
        "question": "Stop infra on mac-mini?",
        "lines": [
          {
            "kind": "text",
            "text": "infra stays stopped until you start it."
          }
        ],
        "danger": true,
        "type": "infra",
        "yes": "Stop infra",
        "no": "Cancel",
        "icon": "app"
      },
      "priority": 2,
      "mutates": true,
      "id": "stop",
      "run": {
        "call": "machines.stop",
        "in": {
          "VM": "infra"
        },
        "target": {
          "name": "jterrazz-mac-mini"
        }
      }
    },
    {
      "label": "Delete",
      "on": "page",
      "confirm": {
        "question": "Delete infra?",
        "lines": [
          {
            "kind": "text",
            "text": "This can't be undone. It goes with its disk (80 GB), its address."
          }
        ],
        "danger": true,
        "type": "infra",
        "yes": "Delete infra",
        "no": "Cancel",
        "icon": "app"
      },
      "priority": 3,
      "mutates": true,
      "id": "delete",
      "run": {
        "call": "machines.delete",
        "in": {
          "VM": "infra"
        },
        "target": {
          "name": "jterrazz-mac-mini"
        }
      },
      "destructive": true
    },
    {
      "label": "Copy ssh admin@infra",
      "on": "page",
      "priority": 4,
      "id": "copy-ssh",
      "run": {
        "copy": "ssh admin@infra"
      },
      "icon": "doc.on.doc",
      "hud": {
        "kind": "list",
        "items": [
          {
            "kind": "text",
            "text": "Copied ssh admin@infra"
          }
        ]
      }
    },
    {
      "key": "cmd+t",
      "label": "Open in Terminal",
      "on": "page",
      "priority": 2,
      "id": "open-station",
      "run": {
        "terminal": true,
        "argv": [
          "--on",
          "infra"
        ]
      },
      "icon": "terminal"
    },
    {
      "label": "More options for infra",
      "on": "page",
      "id": "menu",
      "icon": "ellipsis",
      "submenu": [
        "restart",
        "stop",
        "delete"
      ]
    }
