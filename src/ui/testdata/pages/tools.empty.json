{
  "schema": "station.page/v1",
  "id": "tools",
  "command": "tools",
  "context": {
    "kind": "host"
  },
  "state": "ready",
  "sections": [
    {
      "id": "tools",
      "title": "Tools",
      "role": "banner",
      "columns": [
        {
          "key": "name",
          "kind": "text",
          "keep": 100
        },
        {
          "key": "version",
          "kind": "version",
          "keep": 50
        },
        {
          "key": "method",
          "kind": "list",
          "keep": 30
        }
      ],
      "items": [
        {
          "empty": {
            "noun": "tools"
          }
        }
      ]
    }
  ],
  "hints": [
    {
      "command": "station tools install <tool...>"
    },
    {
      "command": "station tools upgrade"
    }
  ],
  "actions": [
    {
      "key": "i",
      "label": "install",
      "on": "row",
      "confirm": {
        "yes": "install"
      },
      "priority": 1,
      "mutates": true
    },
    {
      "key": "u",
      "label": "uninstall",
      "on": "row",
      "confirm": {
        "yes": "uninstall"
      },
      "priority": 2,
      "mutates": true
    },
    {
      "key": "U",
      "label": "upgrade",
      "on": "row",
      "priority": 3,
      "mutates": true
    }
  ]
}
