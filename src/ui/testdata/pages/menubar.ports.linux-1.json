  "actions": [
    {
      "label": "Share a port",
      "on": "page",
      "priority": 2,
      "mutates": true,
      "id": "share-port",
      "run": {
        "call": "ports.share",
        "in": {
          "VM": "\"linux-1\""
        }
      },
      "form": {
        "title": "Share a port of linux-1",
        "fields": [
          {
            "key": "Port",
            "label": "Port",
            "kind": "text",
            "note": "the port it listens on, inside linux-1",
            "required": true
          }
        ]
      }
    },
    {
      "label": "Stop sharing",
      "on": "row",
      "rows": [
        "linux-1:5173"
      ],
      "confirm": {
        "question": "Stop sharing linux-1's port 5173?",
        "lines": [
          {
            "kind": "text",
            "text": "Its link stops working on Tailscale, and reserved port 40001 is let go."
          }
        ],
        "danger": true,
        "yes": "Stop sharing",
        "no": "Cancel"
      },
      "priority": 3,
      "mutates": true,
      "id": "stop-sharing:linux-1:5173",
      "run": {
        "call": "ports.stop-sharing",
        "in": {
          "Confirm": "yes",
          "Host": "\"macbook\"",
          "Port": "\"5173\"",
          "VM": "\"linux-1\""
        }
      }
    },
    {
      "label": "Stop sharing",
      "on": "row",
      "rows": [
        "linux-1:5432"
      ],
      "confirm": {
        "question": "Stop sharing linux-1's port 5432?",
