{
  "schema": "station.page/v1",
  "id": "menubar.ports",
  "command": "menubar",
  "context": {
    "machine": "jterrazz-macbook-pro",
    "kind": "mac"
  },
  "state": "ready",
  "sections": [
    {
      "id": "summary",
      "title": "Ports",
      "role": "summary",
      "caption": [
        {
          "kind": "text",
          "text": "linux-1"
        },
        {
          "kind": "text",
          "text": "0 public"
        },
        {
          "kind": "text",
          "text": "2 on your tailnet"
        }
      ]
    },
    {
      "id": "private",
      "title": "Private",
      "caption": [
        {
          "kind": "text",
          "text": "2"
        }
      ],
      "columns": [
        {
          "key": "name",
          "kind": "text",
          "keep": 100
        },
        {
          "key": "value",
          "kind": "list",
          "keep": 60
        }
      ],
      "items": [
        {
          "row": {
            "id": "linux-1:5173",
            "mark": "ok",
            "label": "Vite",
            "detail": {
              "kind": "text",
              "text": "linux-1:5173"
            },
            "glyph": {
              "kind": "port:vite"
            },
            "verb": "open-port:linux-1:5173",
            "quick": "qr:linux-1:5173",
            "menu": [
              "open-port:linux-1:5173",
              "copy-port:linux-1:5173",
              "qr:linux-1:5173",
              "-",
              "stop-sharing:linux-1:5173"
            ]
          }
        },
        {
          "row": {
            "id": "linux-1:7000",
            "mark": "ok",
            "label": "Port 7000",
            "detail": {
              "kind": "text",
              "text": "linux-1:7000"
            },
            "glyph": {
              "kind": "port:web"
            },
            "verb": "copy-port:linux-1:7000",
            "menu": [
              "copy-port:linux-1:7000",
              "-",
              "stop-sharing:linux-1:7000"
            ]
          }
        }
      ],
      "counts": [
        {
          "mark": "ok",
          "n": 2
        }
      ],
      "glance": [
        {
          "kind": "text",
          "text": "Private"
        },
        {
          "kind": "text",
          "text": "on your tailnet"
        }
      ],
      "about": {
        "label": "About private links",
        "text": "Private links open only on devices signed in to your tailnet; Public routes are a Cloudflare Tunnel or a Funnel you declared."
      }
    }
  ],
  "actions": [
    {
      "label": "Open Vite",
      "on": "row",
      "rows": [
        "linux-1:5173"
      ],
      "id": "open-port:linux-1:5173",
      "run": {
        "open": "https://jterrazz-macbook-pro.tail77a797.ts.net:40001"
      }
    },
    {
      "label": "Copy link to Vite",
      "on": "row",
      "rows": [
        "linux-1:5173"
      ],
      "id": "copy-port:linux-1:5173",
      "run": {
        "copy": "https://jterrazz-macbook-pro.tail77a797.ts.net:40001"
      },
      "hud": {
        "kind": "list",
        "items": [
          {
            "kind": "text",
            "text": "Copied https://jterrazz-macbook-pro.tail77a797.ts.net:40001"
          }
        ]
      }
    },
    {
      "label": "Show QR for Vite",
      "on": "row",
      "rows": [
        "linux-1:5173"
      ],
      "id": "qr:linux-1:5173",
      "icon": "qrcode"
    },
    {
      "label": "Stop sharing",
      "on": "row",
      "rows": [
        "linux-1:5173"
      ],
      "confirm": {
        "question": "Stop sharing linux-1:5173?",
        "lines": [
          {
            "kind": "text",
            "text": "The link stops answering on your tailnet. What answers on it keeps running inside the VM."
          }
        ],
        "danger": true,
        "yes": "Stop sharing",
        "no": "Cancel",
        "icon": "app"
      },
      "priority": 3,
      "mutates": true,
      "id": "stop-sharing:linux-1:5173",
      "run": {
        "call": "ports.stop-sharing",
        "in": {
          "Confirm": "yes",
          "Mac": "\"jterrazz-macbook-pro\"",
          "Port": "\"5173\"",
          "VM": "\"linux-1\""
        }
      }
    },
    {
      "label": "Copy link to Port 7000",
      "on": "row",
      "rows": [
        "linux-1:7000"
      ],
      "id": "copy-port:linux-1:7000",
      "run": {
        "copy": "linux-1:7000"
      },
      "hud": {
        "kind": "list",
        "items": [
          {
            "kind": "text",
            "text": "Copied linux-1:7000"
          }
        ]
      }
    },
    {
      "label": "Stop sharing",
      "on": "row",
      "rows": [
        "linux-1:7000"
      ],
      "confirm": {
        "question": "Stop sharing linux-1:7000?",
        "lines": [
          {
            "kind": "text",
            "text": "The link stops answering on your tailnet. What answers on it keeps running inside the VM."
          }
        ],
        "danger": true,
        "yes": "Stop sharing",
        "no": "Cancel",
        "icon": "app"
      },
      "priority": 3,
      "mutates": true,
      "id": "stop-sharing:linux-1:7000",
      "run": {
        "call": "ports.stop-sharing",
        "in": {
          "Confirm": "yes",
          "Mac": "\"jterrazz-macbook-pro\"",
          "Port": "\"7000\"",
          "VM": "\"linux-1\""
        }
      }
    },
    {
      "label": "Share a port",
      "on": "page",
      "priority": 3,
      "mutates": true,
      "id": "share-port",
      "form": {
        "title": "Share a port",
        "fields": [
          {
            "key": "Of",
            "label": "Of",
            "kind": "select",
            "default": "share-port",
            "swaps": true
          },
          {
            "key": "Port",
            "label": "Listening now",
            "kind": "rows",
            "note": "No workspace runs to share a port of."
          }
        ],
        "subtitle": "Private on your tailnet. Pick a listener, no typing."
      },
      "sheet": "share-port"
    },
    {
      "label": "Declare public",
      "on": "page",
      "priority": 2,
      "mutates": true,
      "id": "declare-public",
      "run": {
        "call": "ports.declare"
      },
      "form": {
        "title": "Declare a port public",
        "fields": [
          {
            "key": "Port",
            "label": "Port",
            "kind": "select",
            "required": true
          },
          {
            "key": "Via",
            "label": "Via",
            "kind": "select",
            "options": [
              {
                "value": "cloudflare-tunnel",
                "label": "Cloudflare Tunnel"
              },
              {
                "value": "tailscale-funnel",
                "label": "Tailscale Funnel"
              },
              {
                "value": "lan",
                "label": "your LAN"
              }
            ],
            "default": "cloudflare-tunnel",
            "required": true
          }
        ]
      }
    },
    {
      "label": "Full list in Terminal",
      "on": "page",
      "id": "full-list",
      "run": {
        "terminal": true,
        "argv": [
          "ports",
          "--on",
          "linux-1"
        ]
      }
    },
    {
      "label": "More options for Ports",
      "on": "page",
      "id": "menu",
      "icon": "ellipsis",
      "submenu": [
        "share-port@menu",
        "declare-public@menu"
      ]
    },
    {
      "label": "Share a port",
      "on": "menu",
      "priority": 3,
      "mutates": true,
      "id": "share-port@menu",
      "form": {
        "title": "Share a port",
        "fields": [
          {
            "key": "Of",
            "label": "Of",
            "kind": "select",
            "default": "share-port",
            "swaps": true
          },
          {
            "key": "Port",
            "label": "Listening now",
            "kind": "rows",
            "note": "No workspace runs to share a port of."
          }
        ],
        "subtitle": "Private on your tailnet. Pick a listener, no typing."
      },
      "icon": "point.3.connected.trianglepath.dotted",
      "sheet": "share-port"
    },
    {
      "label": "Declare a port public",
      "on": "menu",
      "priority": 2,
      "mutates": true,
      "id": "declare-public@menu",
      "run": {
        "call": "ports.declare"
      },
      "form": {
        "title": "Declare a port public",
        "fields": [
          {
            "key": "Port",
            "label": "Port",
            "kind": "select",
            "required": true
          },
          {
            "key": "Via",
            "label": "Via",
            "kind": "select",
            "options": [
              {
                "value": "cloudflare-tunnel",
                "label": "Cloudflare Tunnel"
              },
              {
                "value": "tailscale-funnel",
                "label": "Tailscale Funnel"
              },
              {
                "value": "lan",
                "label": "your LAN"
              }
            ],
            "default": "cloudflare-tunnel",
            "required": true
          }
        ]
      },
      "icon": "globe"
    }
  ],
  "header": {
    "back": "All machines",
    "glyph": {
      "kind": "symbol:network"
    },
    "buttons": [
      "menu"
    ]
  },
  "footer": {
    "kind": "terminal-list",
    "buttons": [
      "full-list",
      "share-port"
    ]
  }
}
