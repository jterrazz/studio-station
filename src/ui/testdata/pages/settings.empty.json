{
  "schema": "station.page/v1",
  "id": "settings",
  "command": "settings",
  "context": {
    "kind": "host"
  },
  "state": "ready",
  "sections": [
    {
      "id": "set",
      "title": "Set by station",
      "fold": "auto",
      "columns": [
        {
          "key": "name",
          "kind": "text",
          "keep": 100
        },
        {
          "key": "state",
          "kind": "text",
          "keep": 60
        }
      ],
      "pipe_counts": true
    }
  ],
  "hints": [
    {
      "command": "station settings apply"
    },
    {
      "command": "station settings <setting>"
    }
  ],
  "actions": [
    {
      "key": "a",
      "label": "apply",
      "on": "row",
      "priority": 1,
      "mutates": true
    },
    {
      "key": "d",
      "label": "diff",
      "on": "row",
      "priority": 2
    },
    {
      "key": "o",
      "label": "off here",
      "on": "row",
      "confirm": {
        "yes": "off"
      },
      "priority": 3,
      "mutates": true
    }
  ]
}
