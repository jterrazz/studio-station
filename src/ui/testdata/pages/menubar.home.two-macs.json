    {
      "label": "New VM",
      "on": "page",
      "priority": 1,
      "mutates": true,
      "id": "new-vm",
      "run": {
        "call": "machines.create-workspace",
        "in": {
          "Request.Image": "linux",
          "Request.Network": "nat"
        }
      },
      "form": {
        "title": "New VM",
        "fields": [
          {
            "key": "Request.Lifetime",
            "label": "Lifetime",
            "kind": "select",
            "options": [
              {
                "value": "throwaway"
              },
              {
                "value": "permanent"
              }
            ],
            "default": "throwaway"
          },
          {
            "key": "Request.Resources.MemoryBytes",
            "label": "Memory",
            "kind": "select",
            "options": [
              {
                "value": "4294967296",
                "label": "4G"
              },
              {
                "value": "8589934592",
                "label": "8G"
              }
            ],
            "default": "4294967296"
          }
        ]
      }
    },
    {
      "label": "Open station",
      "on": "page",
      "priority": 2,
      "id": "open-station",
      "run": {
        "terminal": true
      }
    },
    {
      "label": "Stop everything",
      "on": "page",
      "confirm": {
        "question": "Stop everything on This Mac?",
        "lines": [
          {
            "kind": "text",
            "text": "linux-1 will stop; its disk is kept"
          },
          {
            "kind": "text",
            "text": "Awake ends, and the engine stays stopped until station engine start or the next login"
          }
        ],
        "danger": true,
        "yes": "Stop"
      },
      "priority": 3,
      "mutates": true,
      "id": "stop-all",
      "run": {
        "call": "engine.stop",
        "in": {
          "By": "the menu bar",
          "Confirm": "yes"
        }
      }
    },
    {
      "label": "sleep",
      "on": "row",
      "rows": [
        "awake"
      ],
      "priority": 4,
      "mutates": true,
      "id": "power-sleep",
      "run": {
        "call": "awake.off"
      }
    },
    {
      "label": "Update all",
      "on": "page",
      "priority": 2,
      "mutates": true,
      "id": "update-all",
      "run": {
        "call": "apps.update"
      }
    }
  ],
