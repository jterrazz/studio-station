  "actions": [
    {
      "key": "cmd+n",
      "label": "New VM",
      "on": "page",
      "priority": 1,
      "mutates": true,
      "id": "new-vm",
      "run": {
        "call": "machines.create-workspace",
        "in": {
          "Request.Image": "linux",
          "Request.Network": "nat"
        },
        "target": {
          "name": "jterrazz-mac-mini"
        }
      },
      "form": {
        "title": "New VM",
        "fields": [
          {
            "key": "Request.Lifetime",
            "label": "Will it last?",
            "kind": "select",
            "options": [
              {
                "value": "throwaway",
                "label": "Throwaway",
                "note": "Deleted when it powers off from inside."
              },
              {
                "value": "permanent",
                "label": "Permanent",
                "note": "Kept until you delete it."
              }
            ],
            "default": "throwaway"
          },
          {
            "key": "Request.Size.MemoryBytes",
            "label": "Memory",
            "kind": "select",
            "options": [
              {
                "value": "4294967296",
                "label": "4 GB"
              },
              {
                "value": "8589934592",
                "label": "8 GB"
              }
            ],
            "default": "4294967296"
          }
        ]
      },
      "icon": "plus"
    },
    {
      "key": "cmd+enter",
      "label": "Open infra in Terminal",
      "on": "row",
      "rows": [
        "infra"
      ],
      "priority": 2,
      "id": "attach:infra",
      "run": {
        "terminal": true,
        "argv": [
          "--on",
          "infra"
        ],
        "target": {
          "name": "jterrazz-mac-mini"
        }
      },
      "icon": "terminal",
      "hud": {
        "kind": "list",
        "items": [
          {
            "kind": "text",
            "text": "infra opened in Terminal"
          }
        ]
      }
    },
    {
      "label": "HTTPS links on mac-mini",
      "on": "row",
      "rows": [
        "https"
      ],
      "mutates": true,
      "id": "https:jterrazz-mac-mini",
      "run": {
        "call": "ports.set-https",
        "in": {
          "On": "false"
        },
        "target": {
          "name": "jterrazz-mac-mini"
        }
      }
    },
    {
      "label": "Lend an account",
      "on": "row",
      "rows": [
        "share-account"
      ],
      "mutates": true,
      "id": "share-account",
      "run": {
        "call": "accounts.share",
        "target": {
          "name": "jterrazz-mac-mini"
        }
      },
      "form": {
        "title": "Lend an account",
        "fields": [
          {
            "key": "With",
            "label": "To",
            "kind": "text",
            "required": true
          },
          {
            "key": "Account",
            "label": "Account",
            "kind": "text",
            "required": true
          },
          {
            "key": "For",
            "label": "For",
            "kind": "segmented",
            "options": [
              {
                "value": "14400000000000",
                "label": "4 hr"
              },
              {
                "value": "43200000000000",
                "label": "12 hr"
              },
              {
                "value": "604800000000000",
                "label": "7 days"
              }
            ],
            "default": "14400000000000"
          }
        ],
        "subtitle": "From mac-mini. It ends by itself."
      },
      "sheet": "share-account"
    },
    {
      "key": "cmd+t",
      "label": "Open in Terminal",
      "on": "page",
      "priority": 2,
      "id": "open-station",
      "run": {
        "terminal": true,
        "argv": [
          "--on",
          "mac-mini"
        ]
      }
    },
    {
      "label": "More options for mac-mini",
      "on": "page",
      "id": "menu",
      "icon": "ellipsis",
      "submenu": [
        "open-station"
      ]
    }
  ],
  "header": {
    "back": "All machines",
    "glyph": {
      "kind": "desktop"
